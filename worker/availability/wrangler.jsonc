{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermanka-availability",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",

  // Served from its own workers.dev address. Both the GitHub Pages preview and
  // production call it there cross-origin (PUBLIC_AVAILABILITY_URL, set as a build
  // variable on the site; the Worker sends CORS *, and tools/headers.mjs adds the
  // origin to the CSP's connect-src).
  //
  // Do NOT add a `routes` entry for www.chalupahermanka.cz/api/availability unless
  // this Worker is deployed in the same Cloudflare account as that zone. It is not:
  // `wrangler deploy` here would fail on the route.

  // No `id`: Wrangler creates the namespace on the first `wrangler deploy` and
  // simulates it locally under `wrangler dev`.
  "kv_namespaces": [{ "binding": "AVAILABILITY_KV" }]

  // Secret, not a var, because the feed URL carries a token:
  //   npx wrangler secret put E_CHALUPY_ICAL_URL
  // Local development reads it from .dev.vars (gitignored). See .dev.vars.example.
}
