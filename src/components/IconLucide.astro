---
/**
 * Premade line icons, from Lucide (ISC licence, `lucide-static`).
 *
 * Separate from Icon.astro on purpose. Icon.astro holds the drawings made for
 * this site   the facts strip's original set and the inquiry form's field marks.
 * This one holds icons somebody else drew, and keeping the two apart means it is
 * always obvious which is which when one of them needs changing.
 *
 * WHY RAW IMPORTS AND NOT `astro-icon`
 * ------------------------------------
 * `?raw` gives the SVG source as a string at build time. Vite tree-shakes the
 * imports, so only the icons actually named below reach the bundle, and the
 * markup is inlined into the HTML   no integration, no sprite sheet, no runtime.
 * The whole of `lucide-static` (2 025 icons) stays in node_modules.
 *
 * WHAT `prepare()` DOES AND WHY
 * -----------------------------
 * Lucide ships each icon as a complete <svg> with its own width, stroke-width of
 * 2 and so on. Two rounds of surgery on it:
 *
 *   1. The wrapper is stripped and only the geometry kept, so the <svg> below  
 *      with this site's 1.5 stroke rather than Lucide's 2   is the one that
 *      renders. At the sizes used here a 2px stroke reads as a UI icon from a
 *      dashboard; 1.5 sits with the rest of the page.
 *   2. Nothing else. There was a `pathLength="1"` pass here to drive a stroke
 *      draw-in; the draw-in is gone (see Icon.astro) and so is the attribute.
 */
import users from 'lucide-static/icons/users.svg?raw';
import bedDouble from 'lucide-static/icons/bed-double.svg?raw';
/*
 * Sauna. It was `heater`   a boxy panel radiator with feet, which at 30px is a
 * white rectangle with lines in it and reads as a microwave, not as heat.
 *
 * Lucide's own tags point at `waves-vertical` for "sauna, steam, heat", and it
 * was rejected: the same strip already carries `waves` for the pond and
 * `waves-ladder` for the hot tub, so a third wave motif two items along would
 * have been three near-identical glyphs in one row.
 *
 * `flame-kindling`   a flame over two crossed logs   is the wood-fired stove
 * this sauna actually has. It shares the row with `brick-wall-fire` for the
 * hearths, but the two silhouettes are not close: a bordered wall against an
 * open fire on the ground.
 */
import flameKindling from 'lucide-static/icons/flame-kindling.svg?raw';
import wavesLadder from 'lucide-static/icons/waves-ladder.svg?raw';
import brickWallFire from 'lucide-static/icons/brick-wall-fire.svg?raw';
import waves from 'lucide-static/icons/waves.svg?raw';
import dog from 'lucide-static/icons/dog.svg?raw';
import accessibility from 'lucide-static/icons/accessibility.svg?raw';

/*
 * ---- The subpage set -------------------------------------------------------
 *
 * Added when /ubytovani, /terminy-a-ceny, /okoli and /kontakt were built. Those
 * four pages are lists of facts   amenities, fees, distances, ways to arrive  
 * and a list of facts is read by scanning, which is what a glyph in the margin
 * is for.
 *
 * They cost NOTHING at runtime. `?raw` resolves at build time and the geometry
 * is inlined into the HTML of whichever page names the icon; no sprite sheet, no
 * client module, and an icon nobody uses never leaves node_modules. So the set
 * is sized for the pages that exist rather than trimmed to the minimum, and a
 * page needing one more does not have to edit this file under three other pages.
 *
 * All of them are drawn by the same hand at the same 1.5 stroke. That is the
 * whole reason for preferring Lucide over bespoke glyphs here   see the note at
 * the top of the file.
 */
import utensils from 'lucide-static/icons/utensils.svg?raw';
import wifi from 'lucide-static/icons/wifi.svg?raw';
import flame from 'lucide-static/icons/flame.svg?raw';
import bath from 'lucide-static/icons/bath.svg?raw';
import showerHead from 'lucide-static/icons/shower-head.svg?raw';
import car from 'lucide-static/icons/car.svg?raw';
import tv from 'lucide-static/icons/tv.svg?raw';
import washingMachine from 'lucide-static/icons/washing-machine.svg?raw';
import refrigerator from 'lucide-static/icons/refrigerator.svg?raw';
import microwave from 'lucide-static/icons/microwave.svg?raw';
import trees from 'lucide-static/icons/trees.svg?raw';
import treePine from 'lucide-static/icons/tree-pine.svg?raw';
import tentTree from 'lucide-static/icons/tent-tree.svg?raw';
import mountainSnow from 'lucide-static/icons/mountain-snow.svg?raw';
import cigaretteOff from 'lucide-static/icons/cigarette-off.svg?raw';
import sofa from 'lucide-static/icons/sofa.svg?raw';
import doorOpen from 'lucide-static/icons/door-open.svg?raw';
import landmark from 'lucide-static/icons/landmark.svg?raw';
import bike from 'lucide-static/icons/bike.svg?raw';
import footprints from 'lucide-static/icons/footprints.svg?raw';
import snowflake from 'lucide-static/icons/snowflake.svg?raw';
import cableCar from 'lucide-static/icons/cable-car.svg?raw';
import sun from 'lucide-static/icons/sun.svg?raw';
import bus from 'lucide-static/icons/bus.svg?raw';
import trainFront from 'lucide-static/icons/train-front.svg?raw';
import store from 'lucide-static/icons/store.svg?raw';
import shoppingCart from 'lucide-static/icons/shopping-cart.svg?raw';
import mail from 'lucide-static/icons/mail.svg?raw';
import phone from 'lucide-static/icons/phone.svg?raw';
import mapPin from 'lucide-static/icons/map-pin.svg?raw';
import banknote from 'lucide-static/icons/banknote.svg?raw';
import wallet from 'lucide-static/icons/wallet.svg?raw';
import creditCard from 'lucide-static/icons/credit-card.svg?raw';
import receipt from 'lucide-static/icons/receipt.svg?raw';
import zap from 'lucide-static/icons/zap.svg?raw';
import droplets from 'lucide-static/icons/droplets.svg?raw';
import calendarDays from 'lucide-static/icons/calendar-days.svg?raw';
import moon from 'lucide-static/icons/moon.svg?raw';
import clock from 'lucide-static/icons/clock.svg?raw';
import ban from 'lucide-static/icons/ban.svg?raw';
import key from 'lucide-static/icons/key.svg?raw';
import info from 'lucide-static/icons/info.svg?raw';
import circleCheck from 'lucide-static/icons/circle-check.svg?raw';
import circleAlert from 'lucide-static/icons/circle-alert.svg?raw';
import shieldCheck from 'lucide-static/icons/shield-check.svg?raw';
import thermometerSun from 'lucide-static/icons/thermometer-sun.svg?raw';
import ruler from 'lucide-static/icons/ruler.svg?raw';

export type LucideName =
  // The homepage facts strip.
  | 'users'
  | 'bed-double'
  | 'flame-kindling'
  | 'waves-ladder'
  | 'brick-wall-fire'
  | 'waves'
  | 'dog'
  | 'accessibility'
  // Inside the cottage.
  | 'utensils'
  | 'wifi'
  | 'flame'
  | 'bath'
  | 'shower-head'
  | 'tv'
  | 'washing-machine'
  | 'refrigerator'
  | 'microwave'
  | 'sofa'
  | 'door-open'
  | 'cigarette-off'
  | 'thermometer-sun'
  // Outside it.
  | 'trees'
  | 'tree-pine'
  | 'tent-tree'
  | 'mountain-snow'
  | 'snowflake'
  | 'sun'
  | 'cable-car'
  | 'bike'
  | 'footprints'
  | 'landmark'
  // Getting there and what is nearby.
  | 'car'
  | 'bus'
  | 'train-front'
  | 'store'
  | 'shopping-cart'
  | 'mail'
  | 'phone'
  | 'map-pin'
  // Money, dates and terms.
  | 'banknote'
  | 'wallet'
  | 'credit-card'
  | 'receipt'
  | 'zap'
  | 'droplets'
  | 'calendar-days'
  | 'moon'
  | 'clock'
  | 'ban'
  | 'key'
  | 'ruler'
  // Interface.
  | 'info'
  | 'circle-check'
  | 'circle-alert'
  | 'shield-check';

const SOURCES: Record<LucideName, string> = {
  users,
  'bed-double': bedDouble,
  'flame-kindling': flameKindling,
  'waves-ladder': wavesLadder,
  'brick-wall-fire': brickWallFire,
  waves,
  dog,
  accessibility,
  utensils,
  wifi,
  flame,
  bath,
  'shower-head': showerHead,
  tv,
  'washing-machine': washingMachine,
  refrigerator,
  microwave,
  sofa,
  'door-open': doorOpen,
  'cigarette-off': cigaretteOff,
  'thermometer-sun': thermometerSun,
  trees,
  'tree-pine': treePine,
  'tent-tree': tentTree,
  'mountain-snow': mountainSnow,
  snowflake,
  sun,
  'cable-car': cableCar,
  bike,
  footprints,
  landmark,
  car,
  bus,
  'train-front': trainFront,
  store,
  'shopping-cart': shoppingCart,
  mail,
  phone,
  'map-pin': mapPin,
  banknote,
  wallet,
  'credit-card': creditCard,
  receipt,
  zap,
  droplets,
  'calendar-days': calendarDays,
  moon,
  clock,
  ban,
  key,
  ruler,
  info,
  'circle-check': circleCheck,
  'circle-alert': circleAlert,
  'shield-check': shieldCheck,
};

interface Props {
  name: LucideName;
  class?: string;
  /** Square, in px. */
  size?: number;
  strokeWidth?: number;
}

function prepare(source: string): string {
  return source
    .replace(/^[\s\S]*?<svg[^>]*>/, '')
    .replace(/<\/svg>[\s\S]*$/, '')
    .trim();
}

/*
 * `rest` exists for the same reason as in Icon.astro: Astro hands a child the
 * parent's `data-astro-cid-…` as a prop and expects it on the root element, but
 * a root rendered through `set:html` does not pick it up on its own. Without the
 * spread, a scoped rule like `.fact-icon { … }` in the calling component
 * silently matches nothing.
 *
 * ⚠ `interface Props` must be declared ABOVE this. Astro only wires it into
 * `Astro.props` when it appears before first use; declared after, `Astro.props`
 * falls back to `Record<string, any>`, `name` becomes `any`, and the check that
 * it is a real icon name disappears without a word.
 */
const { name, class: className, size = 30, strokeWidth = 1.5, ...rest } = Astro.props;
---

<svg
  class={className}
  {...rest}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={prepare(SOURCES[name])}
/>
