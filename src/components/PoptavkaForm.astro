---
/**
 * The inquiry form itself   the single most important component on the site.
 *
 * SPLIT OUT OF Poptavka.astro ON PURPOSE. The form now appears on three pages
 * (`/`, `/terminy-a-ceny`, `/kontakt`) and docs/04-pages.md is explicit that
 * `/kontakt` uses "the same component as `/terminy-a-ceny`". One copy of the
 * markup, one copy of the field set, one copy of the styles: a field added here
 * appears everywhere, and a field that exists on two of three pages is a bug
 * nobody notices until the owner asks why some inquiries have no dates on them.
 *
 * `Poptavka.astro` is the *section*   band colour, heading, lead   and it renders
 * this. A page that wants the form inside its own layout renders this directly.
 *
 * A native <form method="POST">. No fetch, no preventDefault, no framework form
 * library: it must work with JavaScript disabled (docs/03-tech.md §2). Any
 * enhancement added later sits on top of a form that already works without it.
 * That is also why there is no component library here   docs/03-tech.md §1 rules
 * out React/Vue/Svelte, so the card, the icon-prefixed controls and the checkbox
 * are built from the design tokens directly and ship zero bytes of JavaScript.
 *
 * The date field is deliberately free text, not a picker. Someone typing
 * `20.-27.9.` must not be rejected   the Worker parses leniently and passes the
 * raw string through to the email.
 */
import Icon from './Icon.astro';
import { POPTAVKA_ENDPOINT, SITE } from '../data/site';

interface Props {
  /** Extra classes on the <form>   a page wanting a different card width. */
  class?: string;
}

const { class: className } = Astro.props;

/*
 * Which page the inquiry was sent from. The form is on three of them now and the
 * owner's email should say which   an inquiry from /terminy-a-ceny is somebody
 * who has just read the price list, and one from /kontakt usually is not.
 * Hidden rather than a field: it is metadata, not something to ask a guest.
 */
const odkud = Astro.url.pathname;
---

{/*
  TODO(worker): POPTAVKA_ENDPOINT is a placeholder   the Cloudflare Worker is
  not written yet (worker/README.md). It must respond 303 to
  /kontakt/dekujeme on success and 303 back here with an error parameter on
  failure, so a no-JS browser follows both.
*/}
<form class:list={['form', className]} method="POST" action={POPTAVKA_ENDPOINT}>
  {/*
    Honeypot. Hidden from sight, from the tab order and from screen readers;
    a submission that fills it in is a bot. docs/03-tech.md §2.
  */}
  <div class="hp" aria-hidden="true">
    <label for="web">Nevyplňujte toto pole</label>
    <input type="text" id="web" name="web" tabindex="-1" autocomplete="off" />
  </div>

  <input type="hidden" name="odkud" value={odkud} />

  <div class="field">
    <label for="email">
      Váš e-mail <span class="req" aria-hidden="true">*</span>
    </label>
    <div class="control">
      <Icon name="email" class="control-icon" />
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        placeholder="jmeno@example.cz"
        aria-describedby="email-hint"
      />
    </div>
    <p class="hint" id="email-hint">povinná položka</p>
  </div>

  <div class="field">
    <label for="jmeno">Vaše jméno</label>
    <div class="control">
      <Icon name="jmeno" class="control-icon" />
      <input type="text" id="jmeno" name="jmeno" autocomplete="name" />
    </div>
  </div>

  <div class="field">
    <label for="telefon">Telefon</label>
    <div class="control">
      <Icon name="telefon" class="control-icon" />
      <input type="tel" id="telefon" name="telefon" autocomplete="tel" />
    </div>
  </div>

  <div class="field">
    <label for="termin">Požadovaný termín</label>
    <div class="control">
      <Icon name="kalendar" class="control-icon" />
      <input
        type="text"
        id="termin"
        name="termin"
        placeholder="např. 20.–27. 9. 2026"
        autocomplete="off"
        aria-describedby="termin-hint"
      />
    </div>
    <p class="hint" id="termin-hint">
      Stačí přibližně. Termín nám nejvíc pomůže s rychlou odpovědí.
    </p>
  </div>

  <div class="field">
    <label for="dospeli">Počet dospělých</label>
    <div class="control">
      <Icon name="osoby" class="control-icon" />
      <input type="number" id="dospeli" name="dospeli" min="1" max="15" inputmode="numeric" />
    </div>
  </div>

  <div class="field">
    <label for="deti">Počet dětí</label>
    <div class="control">
      <Icon name="deti" class="control-icon" />
      <input type="number" id="deti" name="deti" min="0" max="15" inputmode="numeric" />
    </div>
  </div>

  <div class="field field--wide">
    <label for="zprava">Text zprávy</label>
    <div class="control control--area">
      <Icon name="zprava" class="control-icon" />
      <textarea id="zprava" name="zprava" rows="5"></textarea>
    </div>
  </div>

  {/*
    The whole row is the label, so the tap target is the row and not the
    18px box. The <input> keeps its own id for the same reason it always
    had one: server-side error markup can point at it.
  */}
  <label class="check field--wide" for="kopie">
    <input type="checkbox" id="kopie" name="kopie" value="ano" />
    <span>Poslat mi na e-mail kopii</span>
  </label>

  <div class="actions field--wide">
    <button type="submit" class="btn btn-primary">Odeslat poptávku</button>
    {/* The {' '} is load-bearing: JSX trims the newline before <a>. */}
    <p class="hint">
      Nebo zavolejte na{' '}
      <a href={`tel:${SITE.telHref}`} class="link">{SITE.telefon}</a>.
    </p>
  </div>

  {/*
    TODO(client)   LAUNCH-BLOCKING: this form emails personal data to the
    owner and needs a GDPR line plus a link to how the data is handled.
    docs/01-content.md §9 item 14.
  */}
</form>

<style>
  /*
   * The card. Same shape as .card in global.css   hairline border, --radius-sm,
   * a shallow shadow to lift it off the band behind it. Not the class itself:
   * .card has no shadow, and this one is the destination of the whole site.
   */
  .form {
    display: grid;
    gap: 1.25rem;
    width: 100%;
    max-width: 44rem;
    margin-inline: auto;
    padding: 1.5rem;
    background-color: var(--color-omitka);
    border: 1px solid rgb(62 50 38 / 0.12);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-raised);
  }

  @media (width >= 40rem) {
    .form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
      padding: 2.5rem;
    }

    .field--wide {
      grid-column: 1 / -1;
    }
  }

  @media (width >= 64rem) {
    .form {
      padding: 3rem;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }

  label {
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    color: var(--color-les);
  }

  .req {
    color: var(--color-mosaz-tmava);
  }

  /* Icon and input share one box: the icon is positioned, the input is padded. */
  .control {
    position: relative;
    display: flex;
  }

  .control-icon {
    position: absolute;
    inset-inline-start: 0.875rem;
    top: 50%;
    width: 1.125rem;
    height: 1.125rem;
    transform: translateY(-50%);
    color: var(--color-kura);
    opacity: 0.65;
    transition: color 150ms var(--ease-out), opacity 150ms var(--ease-out);
  }

  /* In a textarea the icon belongs at the first line, not at the middle. */
  .control--area .control-icon {
    top: 1.0625rem;
    transform: none;
  }

  input,
  textarea {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-les);
    /* Tinted against the card so a field reads as a field without a heavy rule. */
    background-color: color-mix(in oklab, var(--color-kamen) 55%, var(--color-omitka));
    border: 1px solid rgb(62 50 38 / 0.22);
    border-radius: var(--radius-sm);
    /* 48px tall: a finger-sized target, and 16px text so iOS never zooms. */
    padding: 0.8125rem 0.875rem 0.8125rem 2.875rem;
    width: 100%;
    min-width: 0;
    transition:
      background-color 150ms var(--ease-out),
      border-color 150ms var(--ease-out);
  }

  textarea {
    resize: vertical;
    min-height: 8rem;
    line-height: 1.6;
  }

  input:hover,
  textarea:hover {
    border-color: var(--color-kura);
  }

  input:focus,
  textarea:focus {
    background-color: var(--color-omitka);
    border-color: var(--color-mosaz);
  }

  /* The focus ring itself is the global :focus-visible rule   never overridden. */
  .control:focus-within .control-icon {
    color: var(--color-mosaz-tmava);
    opacity: 1;
  }

  ::placeholder {
    color: rgb(62 50 38 / 0.55);
    opacity: 1;
  }

  .hint {
    margin: 0;
    font-size: var(--text-caption);
    color: var(--color-kura);
  }

  /* ---- Checkbox --------------------------------------------------------
   * Native input, restyled   not a hidden input with a fake box next to it, so
   * it keeps the native focus ring, the native tab stop and label semantics.
   */
  .check {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: var(--font-weight-normal);
    cursor: pointer;
    /*
     * The row is the target, per the note beside the markup   but the row is
     * only as tall as one line of text, about 26px. This is the only checkbox
     * on the site and it sits between a textarea and the submit button, so a
     * 44px row is both reachable and clear of its neighbours.
     */
    min-height: 44px;
    touch-action: manipulation;
  }

  .check input {
    appearance: none;
    flex: none;
    display: grid;
    place-content: center;
    width: 1.375rem;
    height: 1.375rem;
    margin: 0;
    padding: 0;
    cursor: pointer;
  }

  .check input::after {
    content: '';
    width: 0.5rem;
    height: 0.28rem;
    border-inline-start: 2px solid var(--color-omitka);
    border-block-end: 2px solid var(--color-omitka);
    transform: translateY(-1px) rotate(-45deg);
    opacity: 0;
    transition: opacity 120ms var(--ease-out);
  }

  .check input:checked {
    background-color: var(--color-mosaz);
    border-color: var(--color-mosaz);
  }

  .check input:checked::after {
    opacity: 1;
  }

  /* Windows high contrast: hand the box back to the OS rather than fake one. */
  @media (forced-colors: active) {
    .check input {
      appearance: auto;
    }

    .check input::after {
      content: none;
    }
  }

  /* ---- Submit ---------------------------------------------------------- */
  .actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
    margin-top: 0.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(62 50 38 / 0.12);
  }

  .actions .hint {
    text-align: center;
  }

  @media (width >= 40rem) {
    .actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem 1.5rem;
    }

    .actions .btn {
      flex: none;
    }

    .actions .hint {
      text-align: start;
    }
  }

  /* Honeypot: out of sight, out of the tab order, out of the a11y tree. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
