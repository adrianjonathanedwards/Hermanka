---
/**
 * Koupání v okolí   swimming near the cottage.
 *
 * DATA: src/data/okoli.ts KOUPANI_BLIZKO + KOUPANI_DALSI. The data is split
 * into two arrays for exactly this reason   the two entries in BLIZKO have
 * verified distances from the distance table (§5.2 of docs/01-content.md),
 * the ten in DALSI do not (§9 item 21).
 *
 * Same shape as OkoliLyzovani.astro on purpose: a "here is a verified place"
 * block built from OkoliMistoKarta (one card there, two side by side here
 * the interface never limited it to one), then a footnote grid of the
 * unmeasured names built from OkoliDalsiSeznam. No rules between the pieces
 * in either section   the spacing alone carries the grouping.
 *
 * Both cards now carry a real photograph   see the note on `Koupani.foto` in
 * src/data/okoli.ts for where each one came from. Because this section's own
 * background IS `--color-kamen`, the tile's default fill (see
 * OkoliMedia.astro's `.media-frame`), `.koupani-hlavni` overrides that custom
 * property to `--color-omitka` locally so a tile without a photo   there is
 * none today, but the fallback stays correct if one is ever removed   still
 * reads as a tile and not a hole the same colour as the page.
 *
 * ---------------------------------------------------------------------------
 * THE BACKGROUND PHOTOGRAPH
 *
 * The same `prehrada-pastviny-letecky.webp` the Přehrada Pastviny card uses
 * (client-supplied   see the note on `Koupani.foto` in src/data/okoli.ts), full
 * width behind the whole section instead of cropped to a small tile. Reusing
 * one photograph rather than sourcing a second is deliberate: the crop and the
 * scrim below make the two reads different enough that it doesn't look like
 * repetition, and every photograph on this page being a real, identifiable
 * place beats padding the section out with a generic "water texture" stock
 * shot of nowhere in particular.
 *
 * It sits behind a `--color-kamen` scrim at ~86% opacity   `.koupani::before`
 *   so every contrast ratio computed against a flat --color-kamen ground
 * elsewhere in this file stays true; the photo shows through as texture, not
 * as a competing background the text has to fight.
 *
 * `background-attachment: fixed` only under `(hover: hover) and
 * (prefers-reduced-motion: no-preference)`: a pointer device with no reduced-
 * motion preference gets the "photo stays put, the page moves past it" feel
 * that was asked for; everyone else (touch, or reduced motion) gets the same
 * photograph scrolling normally with the rest of the section. iOS Safari also
 * never implements `fixed` attachment reliably, so gating on `hover: hover`
 * doubles as the fix for that: it degrades to plain `scroll`, not a broken
 * effect.
 * ---------------------------------------------------------------------------
 *
 * Band: --kamen. Follows --jinovatka (lyzovani) and precedes --omitka (CtaBand).
 */
import { getImage } from 'astro:assets';
import { KOUPANI_BLIZKO, KOUPANI_DALSI } from '../../../data/okoli';
import OkoliMistoKarta from './OkoliMistoKarta.astro';
import OkoliDalsiSeznam from './OkoliDalsiSeznam.astro';
import pozadiZdroj from '@img/prehrada-pastviny-letecky.webp';

/* U+00A0   non-breaking space. */
const NBSP = ' ';

const STITKY = ['Nejbližší koupání', 'Největší plocha'];

/* `layout: 'none'`   only `.src` is read below, a full responsive ladder for a
   CSS background-image would be generated and discarded. See the identical
   note in GalerieTeaser.astro. */
const pozadi = await getImage({ src: pozadiZdroj, width: 1920, format: 'webp', quality: 65, layout: 'none' });
---

<section class="koupani section" aria-labelledby="koupani-nadpis" style={`--koupani-bg: url(${pozadi.src})`}>
  <div class="wrap">
    <header class="koupani-header" data-reveal>
      <h2 id="koupani-nadpis">Koupání v okolí</h2>
      <p class="koupani-lead">
        Nejbližší bazén je v Králíkách, 3{NBSP}km odsud. Přehrada Pastviny, největší
        vodní plocha v okolí, je 17{NBSP}km.
      </p>
    </header>

    <div class="koupani-hlavni" data-reveal>
      {
        KOUPANI_BLIZKO.map((k, i) => (
          <OkoliMistoKarta
            icon="waves"
            foto={k.foto}
            stitek={STITKY[i]}
            nazev={k.nazev}
            fakta={k.vzdalenost ? [k.vzdalenost] : []}
            popis={k.popis}
          />
        ))
      }
    </div>

    {
      KOUPANI_DALSI.length > 0 && (
        <OkoliDalsiSeznam
          class="koupani-dalsi"
          icon="waves"
          nadpis="Další koupaliště a aquaparky v kraji"
          poznamka="Vzdálenosti k těmto místům zatím nejsou ověřeny, a proto zde nejsou uvedeny."
          polozky={KOUPANI_DALSI}
          data-reveal
        />
      )
    }
  </div>
</section>

<style>
  .koupani {
    position: relative;
    /* Contains the scrim's negative z-index to THIS section, so it cannot
       escape and paint behind an ancestor's background instead   plain
       `position: relative` with no `z-index` set does not by itself create a
       new stacking context, and without one `z-index: -1` below would resolve
       against whatever the nearest actual stacking context is instead. */
    isolation: isolate;
    /* Fallback ground, and what the scrim below is colour-matched to. */
    background-color: var(--color-kamen);
    background-image: var(--koupani-bg);
    background-size: cover;
    background-position: center 60%;
    background-repeat: no-repeat;
  }

  /* "Stuck in one spot, the page moves around it": only where it costs nothing
     to get wrong   a pointer device, no reduced-motion preference. Everything
     else (touch, or reduced motion) gets the same photograph scrolling with
     the section, which is a perfectly normal background image. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .koupani {
      background-attachment: fixed;
    }
  }

  /*
   * The scrim: --color-kamen again, at high opacity, over the photograph. Every
   * contrast ratio commented elsewhere in this file (mosaz-tmava on kamen =
   * 5.06:1, kura on kamen = 9.96:1, ...) was measured against a FLAT kamen
   * ground, and stays true because this reads as close to flat kamen with the
   * photo underneath as texture   not as a competing photograph the text has to
   * fight for contrast against.
   *
   * Negative z-index, not DOM order: `.koupani`'s `isolation: isolate` above
   * gives it its own stacking context, so this paints behind the section's own
   * normal-flow content automatically, without needing `position: relative` on
   * `.wrap` too.
   */
  .koupani::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: rgb(232 230 224 / 0.86);
    pointer-events: none;
  }

  h2 {
    /* --mosaz-tmava on --kamen = 5.06:1 */
    color: var(--color-mosaz-tmava);
  }

  .koupani-header {
    max-width: 48ch;
  }

  .koupani-lead {
    margin-top: 1rem;
    font-size: var(--text-lead);
    /* --kura on --kamen = 9.96:1 */
    color: var(--color-kura);
  }

  .koupani-hlavni {
    display: grid;
    gap: 2rem;
    margin-top: 3.5rem;
    /* The section band IS --color-kamen, the tile's own default fill (see
       OkoliMedia.astro's `.media-frame`), so without this override a tile
       with no photo would sit invisibly on a same-colour ground. */
    --color-kamen: var(--color-omitka);
  }

  @media (width >= 40rem) {
    .koupani-hlavni {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* No rule here either   see the header comment. Matches via the cid
     OkoliDalsiSeznam forwards onto its own root   no :global() needed. */
  .koupani-dalsi {
    margin-top: 3.5rem;
  }
</style>
