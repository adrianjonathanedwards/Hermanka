---
/**
 * Koupání v okolí   swimming near the cottage.
 *
 * DATA: src/data/okoli.ts KOUPANI_BLIZKO + KOUPANI_DALSI. The data is split
 * into two arrays for exactly this reason   the two entries in BLIZKO have
 * verified distances from the distance table (§5.2 of docs/01-content.md),
 * the ten in DALSI do not (§9 item 21).
 *
 * Same shape as OkoliLyzovani.astro on purpose: a bordered "here is a
 * verified place" block built from OkoliMistoKarta (one card there, two
 * side by side here   the interface never limited it to one), then a
 * footnote run of the unmeasured names built from OkoliDalsiSeznam.
 *
 * The two cards get an icon tile, not a photo   no photograph of either place
 * has been sourced for this project (see the note on `Vylet.foto` in
 * src/data/okoli.ts for which places do have one). Because this section's own
 * background IS `--color-kamen`, the tile's default fill, `.koupani-hlavni`
 * overrides that custom property to `--color-omitka` locally so the tile
 * still reads as a tile and not a hole the same colour as the page.
 *
 * Band: --kamen. Follows --jinovatka (lyzovani) and precedes --omitka (CtaBand).
 */
import { KOUPANI_BLIZKO, KOUPANI_DALSI } from '../../../data/okoli';
import OkoliMistoKarta from './OkoliMistoKarta.astro';
import OkoliDalsiSeznam from './OkoliDalsiSeznam.astro';

/* U+00A0   non-breaking space. */
const NBSP = ' ';

const STITKY = ['Nejbližší koupání', 'Největší plocha'];
---

<section class="koupani section" aria-labelledby="koupani-nadpis">
  <div class="wrap">
    <header class="koupani-header" data-reveal>
      <h2 id="koupani-nadpis">Koupání v okolí</h2>
      <p class="koupani-lead">
        Nejbližší bazén je v Králíkách, 3{NBSP}km odsud. Přehrada Pastviny, největší
        vodní plocha v okolí, je 17{NBSP}km.
      </p>
    </header>

    <div class="koupani-hlavni" data-reveal>
      {
        KOUPANI_BLIZKO.map((k, i) => (
          <OkoliMistoKarta
            icon="waves"
            stitek={STITKY[i]}
            nazev={k.nazev}
            fakta={k.vzdalenost ? [{ hodnota: k.vzdalenost, popis: 'vzdušnou čarou' }] : []}
          />
        ))
      }
    </div>

    {
      KOUPANI_DALSI.length > 0 && (
        <OkoliDalsiSeznam
          class="koupani-dalsi"
          icon="waves"
          nadpis="Další koupaliště a aquaparky v kraji"
          poznamka="Vzdálenosti k těmto místům zatím nejsou ověřeny, a proto zde nejsou uvedeny."
          polozky={KOUPANI_DALSI}
          data-reveal
        />
      )
    }
  </div>
</section>

<style>
  .koupani {
    background-color: var(--color-kamen);
  }

  h2 {
    /* --mosaz-tmava on --kamen = 5.06:1 */
    color: var(--color-mosaz-tmava);
  }

  .koupani-header {
    max-width: 48ch;
  }

  .koupani-lead {
    margin-top: 1rem;
    font-size: var(--text-lead);
    /* --kura on --kamen = 9.96:1 */
    color: var(--color-kura);
  }

  .koupani-hlavni {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 2px solid var(--color-mosaz);
    /* The section band IS --color-kamen, the tile's own default fill (see
       OkoliMedia.astro's `.media-frame`), so without this override the icon
       tiles below would sit invisibly on a same-colour ground. */
    --color-kamen: var(--color-omitka);
  }

  @media (width >= 40rem) {
    .koupani-hlavni {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* A hairline, not the 2px brass rule above: see OkoliLyzovani.astro's
     equivalent note on why this reads as subordinate. Matches via the cid
     OkoliDalsiSeznam forwards onto its own root   no :global() needed. */
  .koupani-dalsi {
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgb(22 36 28 / 0.14);
  }
</style>
