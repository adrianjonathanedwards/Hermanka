---
/**
 * The visual for one place: a real photograph where one exists, an icon tile
 * where it does not. Shared by OkoliVylety, OkoliLyzovani and OkoliKoupani so
 * the three lists that got new photo/icon tiles read as one system rather than
 * three separate attempts at the same idea.
 *
 * ---------------------------------------------------------------------------
 * WHY A TILE, AND WHY THE SAME TILE FOR BOTH CASES
 *
 * This site has nine photographs total (src/data/galerie.ts) and exactly one of
 * them is usable here   `dolnimorava.webp`, because it is a photograph OF the
 * ski resort and two-and-a-bit entries across this page are literally that
 * resort. Klepáč, Králický Sněžník, Klášter Hedeč, Vojenské muzeum Králíky,
 * Bazén Králíky, Přehrada Pastviny and every other name on the page are
 * third-party places nobody has photographed for this project, and there is no
 * honest photograph to put next to them. Inventing one   a generic stock shot of
 * "a mountain" or "a lake"   would show the reader something that is not the
 * place named beside it, which is worse than showing nothing.
 *
 * So both cases render in the SAME frame: `.media-frame` from global.css,
 * `--color-kamen` fill, square corners, no rounding. A photograph fills it; an
 * icon centres in it at the size a photograph's focal subject would occupy. The
 * one tell that a tile has no photograph is that it has no photograph   the icon
 * sits on a flat fill instead of on pixels   and that is meant to read exactly as
 * "no picture of this yet", not as a broken image or a design mistake.
 *
 * Decorative in both cases (`alt=""` / `aria-hidden`). The place name and
 * description beside every tile already say everything the tile could   this is
 * a supporting visual, not a second source of information, the same reasoning
 * OkoliIntro.astro gives for its own `alt=""` on the same photograph.
 *
 * SIZING is the caller's job. This component fills whatever box it is given  
 * pass a `class` and set `width`/`height` (or `aspect-ratio`) on it in the
 * caller's own scoped `<style>`. `rest` carries the parent's `data-astro-cid-…`
 * onto the root so that scoped rule matches without `:global()`   see the note
 * on the same pattern in EdgePines.astro.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import IconLucide from '../../IconLucide.astro';
import type { LucideName } from '../../IconLucide.astro';

interface Props {
  icon: LucideName;
  foto?: ImageMetadata;
  class?: string;
}

const { icon, foto, class: className, ...rest } = Astro.props;
---

<div class:list={['media-frame', 'okoli-media', className]} {...rest}>
  {
    foto ? (
      <Image
        src={foto}
        alt=""
        widths={[96, 176, 288]}
        sizes="7rem"
        width={288}
        height={288}
        format="webp"
        quality={62}
        loading="lazy"
        class="okoli-media-foto"
      />
    ) : (
      <div class="okoli-media-ikona" aria-hidden="true">
        <IconLucide name={icon} size={24} />
      </div>
    )
  }
</div>

<style>
  .okoli-media {
    flex: none;
    aspect-ratio: 1;
  }

  .okoli-media-foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .okoli-media-ikona {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    /* --mosaz-tmava on --kamen = 5.06:1. A stroke, not a fill   the tile's own
       --color-kamen background (from `.media-frame`) is the "no photo" tell. */
    color: var(--color-mosaz-tmava);
  }
</style>
