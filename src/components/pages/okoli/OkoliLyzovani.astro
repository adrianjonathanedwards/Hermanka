---
/**
 * Lyžování v okolí   nearby ski areas.
 *
 * DATA: src/data/okoli.ts LYZOVANI. Only the first entry (Dolní Morava) has a
 * verified distance   it is the one in the distance table (§5.2 of
 * docs/01-content.md). The remaining six entries have vzdalenost: null and
 * cas: null and stay that way until the client supplies figures (§9 item 21).
 *
 * Same shape as OkoliKoupani.astro on purpose: a bordered "here is a verified
 * place" block built from OkoliMistoKarta, then a footnote run of the
 * unmeasured names built from OkoliDalsiSeznam. Two sections about "nearby
 * things with mostly-missing distances" now look like one system instead of
 * two different attempts at the same problem.
 *
 * Band: --jinovatka, docs/02-design-system.md §1's WINTER ACCENT ONLY colour.
 * Follows --omitka (vylety) and precedes --kamen (koupani).
 */
import { LYZOVANI } from '../../../data/okoli';
import OkoliMistoKarta from './OkoliMistoKarta.astro';
import OkoliDalsiSeznam from './OkoliDalsiSeznam.astro';

/* U+00A0   non-breaking space. */
const NBSP = ' ';

/* The first entry is the only one with a verified distance. */
const [dolniMorava, ...ostatni] = LYZOVANI;

const fakta = [
  ...(dolniMorava.vzdalenost ? [{ hodnota: dolniMorava.vzdalenost, popis: 'vzdušnou čarou' }] : []),
  ...(dolniMorava.cas ? [{ hodnota: dolniMorava.cas, popis: 'autem z chalupy' }] : []),
];

const popis = `Deset kilometrů sjezdovek s umělým zasněžováním, Stezka${NBSP}v oblacích, Sky Bridge${NBSP}721, bobová dráha a dětské zábavní areály.`;
---

<section class="lyzovani section" aria-labelledby="lyzovani-nadpis">
  <div class="wrap">
    <header class="lyzovani-header" data-reveal>
      <h2 id="lyzovani-nadpis">Lyžování v okolí</h2>
    </header>

    <div class="lyzovani-hlavni" data-reveal>
      <OkoliMistoKarta
        icon="cable-car"
        foto={dolniMorava.foto}
        stitek="Nejbližší středisko"
        nazev={dolniMorava.nazev}
        fakta={fakta}
        popis={popis}
      />
    </div>

    {
      ostatni.length > 0 && (
        <OkoliDalsiSeznam
          class="lyzovani-dalsi"
          icon="snowflake"
          nadpis="Další střediska v okolí"
          poznamka="Vzdálenosti k těmto střediskům zatím nejsou ověřeny, a proto zde nejsou uvedeny."
          polozky={ostatni.map((s) => s.nazev)}
          data-reveal
        />
      )
    }
  </div>
</section>

<style>
  .lyzovani {
    /*
     * docs/02-design-system.md §1: --jinovatka is a winter accent only   ski
     * content, snow, cold months. This is one of the very few places it may
     * legitimately appear as a section background.
     */
    background-color: var(--color-jinovatka);
  }

  h2 {
    /* --mosaz-tmava on --jinovatka = 4.81:1   the tightest passing case here. */
    color: var(--color-mosaz-tmava);
  }

  .lyzovani-hlavni {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 2px solid var(--color-mosaz);
  }

  /* A hairline, not the 2px brass rule above: this list is subordinate to the
     verified card, and the weight of the rule is what says so.
     ⚠ Matches via the cid `OkoliDalsiSeznam` forwards onto its own root
     through `...rest`   see the note in that file. No :global() needed. */
  .lyzovani-dalsi {
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgb(22 36 28 / 0.14);
  }
</style>
