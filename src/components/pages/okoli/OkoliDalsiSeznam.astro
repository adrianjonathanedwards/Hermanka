---
/**
 * The footnote every unmeasured-place list ends with: a heading, one line
 * saying why there is no figure, and the names themselves as a plain two-
 * column list   a small icon before each one, no rules or boxes. Shared by
 * OkoliLyzovani and OkoliKoupani so their two "we don't have a distance for
 * these yet" lists are the same component, not two hand-built lookalikes.
 */
import IconLucide from '../../IconLucide.astro';
import type { LucideName } from '../../IconLucide.astro';

interface Props {
  icon: LucideName;
  nadpis: string;
  poznamka: string;
  polozky: string[];
  class?: string;
}

const { icon, nadpis, poznamka, polozky, class: className, ...rest } = Astro.props;
---

<div class:list={['dalsiseznam', className]} {...rest}>
  <h3 class="dalsiseznam-nadpis">{nadpis}</h3>
  <p class="dalsiseznam-pozn">{poznamka}</p>

  {/*
    Two columns from the smallest viewport where a long name still fits one
    line; one column below it. Still a plain `<ul>`   a screen reader hears a
    list of N items in source order regardless of how the grid wraps them. The
    icon is `aria-hidden`, so what it hears is the plain names, nothing else.
  */}
  <ul class="dalsiseznam-mrizka" role="list">
    {
      polozky.map((nazev) => (
        <li>
          <IconLucide name={icon} size={14} class="dalsiseznam-ikona" />
          <span>{nazev}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .dalsiseznam-nadpis {
    font-size: var(--text-title-s);
  }

  .dalsiseznam-pozn {
    margin-top: 0.5rem;
    font-size: var(--text-caption);
    max-width: 56ch;
    color: var(--color-kura);
  }

  .dalsiseznam-mrizka {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem 2.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 34rem) {
    .dalsiseznam-mrizka {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .dalsiseznam-mrizka li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-body);
    color: var(--color-les);
  }

  .dalsiseznam-ikona {
    flex: none;
    color: var(--color-mosaz-tmava);
  }
</style>
