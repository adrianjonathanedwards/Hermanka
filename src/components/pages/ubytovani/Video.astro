---
/**
 * Video   the last content section of /ubytovani (#video).
 *
 * YouTube ID: `VIDEO.aktualni` in src/data/site.ts, the September 2026 video.
 * It replaced `-U_w_kwtzjI` here; the old one lives on in /galerie's video
 * section, beside the new one.
 *
 * The 360° walkthrough is linked under the lead, as a plain button to a new
 * window. It sits in this section because it answers the same question the
 * video does ("what is it actually like inside?"), and this is the page where
 * a guest asks it. It stays a link, never an embed   see the header of
 * VideoLightbox.astro for why the two are not the same decision.
 *
 * NO IFRAME UNTIL CLICKED. The poster below is a plain image; with
 * JavaScript, src/scripts/motion.ts intercepts the click and opens the video
 * in the on-site overlay (src/components/VideoLightbox.astro) instead of
 * following the link. Without it, the href is the real YouTube URL and the
 * click leaves the site exactly as it always did   this is a progressive
 * enhancement, not a replacement, and the fallback is not a worse copy of the
 * real thing, it IS the real thing. Full argument in docs/03-tech.md "Video".
 *
 * ⚠ /video/ 301-redirects to /ubytovani#video (public/_redirects). The anchor
 * #video therefore MUST exist and MUST sit on a stable element.
 *
 * Poster: the hot tub in the trees.
 *
 * ⚠ NOT the living room, which is the obvious choice and is already the
 * photograph in the Ložnice split at the top of this page. The same picture
 * twice on one page reads as a site that has run out of them   and it has only
 * nine, so it must not look like it. This one appears nowhere else on /ubytovani.
 */
import { Image } from 'astro:assets';
import virivka from '@img/DSC_4684-scaled-1.jpg';
import Icon from '../../Icon.astro';
import IconLucide from '../../IconLucide.astro';
import { VIDEO, videoUrl, PROHLIDKA_URL } from '../../../data/site';
---

<section id="video" class="section video-sekce" aria-labelledby="video-nadpis">
  <div class="wrap">
    <div class="video-grid">

      {/* ---- Description -------------------------------------------------- */}
      <div class="video-copy" data-reveal>
        <h2 id="video-nadpis">Chalupa na&nbsp;videu</h2>
        <p class="video-lead">
          Prohlédněte si vybavení chalupy a&nbsp;veškeré možnosti vyžití,
          které vám nabízí.
        </p>
        <p class="video-prohlidka">
          <a class="btn btn-secondary" href={PROHLIDKA_URL} target="_blank" rel="noopener noreferrer">
            <IconLucide name="rotate-3d" size={18} />
            <span>Virtuální prohlídka 360°</span>
            <span class="sr-only"> (otevře se v novém okně)</span>
          </a>
        </p>
      </div>

      {/*
        A link, not a button   href is the canonical YouTube URL, and
        `target="_blank"` + `rel="noopener noreferrer"` is the security
        standard for new windows, which is what this stays without
        JavaScript. `data-video-id` is what src/scripts/motion.ts looks for
        to intercept the click and open the on-site overlay instead.
      */}
      <a
        class="video-frame photo-frame"
        href={videoUrl(VIDEO.aktualni)}
        target="_blank"
        rel="noopener noreferrer"
        data-video-id={VIDEO.aktualni}
        data-reveal
        data-reveal-delay="80"
      >
        <Image
          src={virivka}
          alt="Náhled videa o chalupě Heřmanka. Dřevěná vířivka na terase obklopená lesem"
          widths={[420, 640, 960, 1280]}
          sizes="(min-width: 64rem) 56vw, 100vw"
          width={1920}
          height={1282}
          format="webp"
          layout="none"
          quality={68}
          loading="lazy"
        />

        {/* Overlay with play icon */}
        <span class="video-play">
          <span class="video-play-ring">
            <Icon name="prehrat" size={24} strokeWidth={1.5} />
          </span>
          <span>
            Přehrát
            <span class="sr-only"> video na YouTube</span>
            {/*
              True only until src/scripts/motion.ts wires this trigger to the
              overlay, at which point it clears this node's text   see the
              note there. Kept as its own span, not appended inline, so the
              script can find and empty exactly this part of the name.
            */}
            <span class="sr-only" data-video-novo-okno> (otevře se v novém okně)</span>
          </span>
        </span>
      </a>

    </div>
  </div>
</section>

<style>
  .video-sekce {
    background-color: var(--color-kamen);
  }

  /* ---- Grid: description left, video right --------------------------------- */
  .video-grid {
    display: grid;
    gap: 2rem;
  }

  @media (width >= 64rem) {
    .video-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: 4rem;
      align-items: center;
    }
  }

  /* ---- Description ------------------------------------------------------------- */
  h2 {
    /* --mosaz-tmava on --kamen = 5.06:1 */
    color: var(--color-mosaz-tmava);
  }

  .video-lead {
    margin-top: 1rem;
    font-size: var(--text-lead);
    max-width: 36ch;
  }

  .video-prohlidka {
    margin-top: 1.75rem;
  }

  /* ---- Video frame ------------------------------------------------------- */
  .video-frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-les);
    /* Rounded corners to set it apart from gallery photos */
    border-radius: var(--radius-sm);
  }

  .video-frame :global(img) {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  /* Overlay with icon and label */
  .video-play {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    /* scrim: --les at ~42 % */
    background-color: rgb(22 36 28 / 0.42);
    color: var(--color-omitka);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    transition: background-color 300ms var(--ease-out);
  }

  @media (hover: hover) {
    .video-frame:hover .video-play,
    .video-frame:focus-visible .video-play {
      background-color: rgb(22 36 28 / 0.26);
    }
  }

  /* Ring around the play icon */
  .video-play-ring {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.75rem;
    height: 3.75rem;
    border: 2px solid var(--color-omitka);
    border-radius: var(--radius-pill);
    transition:
      transform 380ms var(--ease-spring),
      background-color 300ms var(--ease-out),
      border-color 300ms var(--ease-out);
  }

  @media (hover: hover) {
    .video-frame:hover .video-play-ring,
    .video-frame:focus-visible .video-play-ring {
      transform: scale(1.08);
      background-color: var(--color-mosaz);
      border-color: var(--color-mosaz);
    }
  }

  /*
   * ⚠ THERE WAS AN INFINITE PULSE RING ON THIS BUTTON AND IT WAS REMOVED.
   *
   * A second ring expanding out of the play mark every 2.8 seconds, forever,
   * gated behind `prefers-reduced-motion` and therefore technically legal. It
   * still had to go, for the reason written at the top of src/components/Icon.astro
   * when the same thing was taken off the amenity glyphs: something moving on
   * its own, permanently, with nothing having asked it to, is a page decorating
   * itself   and it is the clearest single sign that nobody chose any of it.
   *
   * The play mark does not need to attract attention. It is a white ring with a
   * triangle in it, centred on a photograph, and every reader on earth knows
   * what it does. The hover above is the whole interaction.
   */
</style>
