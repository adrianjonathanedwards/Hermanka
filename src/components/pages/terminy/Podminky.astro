---
/**
 * Podmínky   payment terms and the terms that are still missing.
 *
 * Two parts, both required:
 *
 * 1. PODMINKY   the terms that ARE known, rewritten from the old site's
 *    120-word paragraph into a list of named steps. Every fact matches the
 *    old text; only the structure changes (docs/01-content.md §6.4 REWRITE).
 *
 * 2. CHYBEJICI_PODMINKY   the terms that are NOT known, rendered honestly as
 *    "na tohle se nás zeptejte". This is not a placeholder and must not be
 *    dropped because the page looks tidier without it. Bed linen is "the
 *    single most-asked question for a Czech chalupa let and this site answers
 *    it nowhere" (docs/01-content.md §6.4). A guest who cannot find the
 *    answer writes to us   which is the site's entire job   whereas a guest
 *    who does not know the question was askable books elsewhere.
 *
 * Section band: --kamen. Previous section (Poplatky) is --omitka.
 * Poptavka below passes band="omitka" because this section is stone.
 *
 * TODO(client)   docs/01-content.md §9 items 9–12. Each answer from the
 * client removes one line from CHYBEJICI_PODMINKY and adds one to PODMINKY:
 *   item 9:  check-in / check-out times
 *   item 10: cancellation terms
 *   item 11: what the price includes (bed linen, towels, firewood, pellets)
 *   item 12: pets   allowed, charged, how limited?
 *
 * TODO(client)   docs/01-content.md §9 item 8: the discount rule.
 * The old homepage promises a flat 10 % for under-occupancy; the old price
 * list says a discount "is possible". The PODMINKY entry for "Menší skupina"
 * deliberately states neither number   only the client knows which is correct.
 */
import IconLucide from '../../IconLucide.astro';
import { PODMINKY, CHYBEJICI_PODMINKY } from '../../../data/cenik';

const NBSP = ' ';
---

<section class="section podminky" aria-labelledby="podminky-nadpis">
  <div class="wrap">

    {/* ---- Part 1: known terms ------------------------------------------- */}

    <div class="podminky-head" data-reveal>
      <h2 id="podminky-nadpis">Podmínky</h2>
      <p class="lead">
        Průběh rezervace a platby, přesně jak funguje.
      </p>
    </div>

    <ol class="kroky" data-reveal data-reveal-delay="60">
      {PODMINKY.map((p, i) => (
        <li class="krok card">
          <div class="krok-hlava">
            <span class="krok-cislo" aria-hidden="true">{i + 1}</span>
            <IconLucide name={p.icon} size={20} class="krok-ikona" />
            <h3 class="krok-nazev">{p.nazev}</h3>
          </div>
          <p class="krok-popis">{p.popis}</p>
        </li>
      ))}
    </ol>

    {/* ---- Part 2: missing terms ----------------------------------------- */}

    {/*
      ⚠ This section is not decoration and not a placeholder. It is the honest
      answer to "what does this site not yet tell you?"   and each item on the
      list is something a real guest will ask before booking a mountain cottage.
      Bed linen is the canonical example: no Czech guest assumes it is provided,
      and the old site is silent on the question. A guest who has to ask finds
      our phone number. A guest who assumes and is wrong arrives unprepared.

      Every item here is a docs/01-content.md §9 item. Each one removed from
      this list should move to PODMINKY above.
    */}
    <div class="chybi" data-reveal data-reveal-delay="120">
      <h3 class="chybi-nadpis">Na{NBSP}tohle se{NBSP}nás zeptejte</h3>
      <p class="chybi-lead">
        Odpovědi máme   jen je zatím nemáme na webu. Napište nám a ozveme
        se obratem.
      </p>

      <ul class="chybi-list">
        {CHYBEJICI_PODMINKY.map((nazev) => (
          <li class="chybi-polozka">
            <IconLucide name="info" size={18} class="chybi-ikona" />
            <span>{nazev}</span>
          </li>
        ))}
      </ul>

      <div class="chybi-cta">
        <a href="#poptavka" class="btn btn-secondary">
          Napsat se{NBSP}zeptat
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  /* ---- Section band ---------------------------------------------------- */

  .podminky {
    background-color: var(--color-kamen);
  }

  /* ---- Head ------------------------------------------------------------ */

  .podminky-head {
    max-width: var(--container-prose);
  }

  h2 {
    /* --les on --kamen = 12.91:1 ✓ */
    color: var(--color-les);
  }

  .lead {
    margin-top: 1rem;
    font-size: var(--text-lead);
    color: var(--color-kura);
  }

  /* ---- Steps list ------------------------------------------------------ */

  /*
   * Ordered list   the numbers are semantic (step 1, step 2, ...) and the
   * visual counter next to the icon reinforces that. Using `list-style: none`
   * here because we render the number ourselves inside `.krok-cislo`.
   */
  .kroky {
    display: grid;
    gap: 1rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: krok;
  }

  @media (width >= 48rem) {
    .kroky {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  /* ---- Individual step card ------------------------------------------- */

  .krok {
    gap: 0.75rem;
  }

  .krok-hlava {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  /*
   * The step number   a small brass circle in the heading row. It pairs with
   * the icon so a reader who skims the headings can count the steps.
   */
  .krok-cislo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-mosaz);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    /* --omitka on --mosaz = 5.14:1 ✓   primary button pairing */
    color: var(--color-omitka);
    /* Tabular for the digit itself, but it's decorative here   no line-up needed. */
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .krok-ikona {
    flex: none;
    /* --mosaz-tmava on --omitka (card bg) = 6.05:1 ✓ */
    color: var(--color-mosaz-tmava);
  }

  /*
   * Step labels are UI labels, not headings in the display sense.
   * docs/02-design-system.md §2.6: Fraunces is "never for UI labels, never
   * below 20 px". Public Sans at body size matches how Ubytovani.astro uses
   * font-family: var(--font-body) on its table row headers.
   */
  .krok-nazev {
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: var(--font-weight-semibold);
    color: var(--color-les);
  }

  .krok-popis {
    font-size: var(--text-body);
    color: var(--color-kura);
    margin: 0;
    max-width: none;
    line-height: 1.6;
  }

  /* ---- Missing terms panel --------------------------------------------- */

  /*
   * A distinct panel, visually separated from the steps above.
   * Uses a left-border accent   the same device KalendarSlot uses for the
   * booking rules, because both are "information you must have before you act".
   */
  .chybi {
    margin-top: 3rem;
    padding: 1.5rem;
    background-color: var(--color-omitka);
    border-left: 3px solid var(--color-mosaz);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  @media (width >= 48rem) {
    .chybi {
      padding: 2rem 2.5rem;
      max-width: 46rem;
    }
  }

  .chybi-nadpis {
    font-size: var(--text-title-s);
    /* --mosaz-tmava on --omitka = 6.05:1 ✓ */
    color: var(--color-mosaz-tmava);
  }

  .chybi-lead {
    margin-top: 0.5rem;
    font-size: var(--text-body);
    color: var(--color-kura);
    max-width: none;
  }

  /* ---- Missing-item list ----------------------------------------------- */

  .chybi-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .chybi-polozka {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: var(--text-body);
    color: var(--color-les);
    line-height: 1.5;
  }

  .chybi-ikona {
    flex: none;
    margin-top: 0.15rem;
    /* --mosaz-tmava on --omitka = 6.05:1 ✓ */
    color: var(--color-mosaz-tmava);
  }

  /* ---- CTA ------------------------------------------------------------- */

  .chybi-cta {
    margin-top: 1.5rem;
  }

  /*
   * .btn-secondary on --omitka ground: transparent fill, --mosaz-tmava text
   * and --mosaz border. --mosaz-tmava on --omitka = 6.05:1 ✓.
   */
</style>
