---
/**
 * Průběh rezervace a platby   the booking steps, then the additional terms.
 *
 * Two parts:
 *
 * 1. PODMINKY   the client's three booking steps (Rezervace, Záloha, Menší
 *    skupina), worded as in the September 2026 brief.
 *
 * 2. DOPLNUJICI_INFO   check-in and check-out, cancellation terms and pets.
 *    This panel used to be "Na tohle se nás zeptejte", a list of questions the
 *    site could not yet answer (docs/01-content.md §9 items 9–12). The client
 *    has answered 9, 10 and 12, so it now shows the answers. Item 11 (what the
 *    price includes: bed linen, towels, firewood) is still unanswered and was
 *    left out by the same brief.
 *
 * Section band: --kamen. Previous section (Poplatky) is --omitka.
 * Poptavka below passes band="omitka" because this section is stone.
 */
import IconLucide from '../../IconLucide.astro';
import { PODMINKY, DOPLNUJICI_INFO } from '../../../data/cenik';

const NBSP = ' ';
---

<section class="section podminky" aria-labelledby="podminky-nadpis">
  <div class="wrap">

    {/* ---- Part 1: booking steps ----------------------------------------- */}

    <div class="podminky-head" data-reveal>
      <h2 id="podminky-nadpis">Průběh rezervace a{NBSP}platby</h2>
    </div>

    <ol class="kroky" data-reveal data-reveal-delay="60">
      {PODMINKY.map((p, i) => (
        <li class="krok card">
          <div class="krok-hlava">
            <span class="krok-cislo" aria-hidden="true">{i + 1}</span>
            <IconLucide name={p.icon} size={20} class="krok-ikona" />
            <h3 class="krok-nazev">{p.nazev}</h3>
          </div>
          <p class="krok-popis">{p.popis}</p>
        </li>
      ))}
    </ol>

    {/* ---- Part 2: additional information -------------------------------- */}

    <div class="info" data-reveal data-reveal-delay="120">
      <h3 class="info-nadpis">Doplňující informace</h3>

      <ul class="info-list">
        {DOPLNUJICI_INFO.map((d) => (
          <li class="info-polozka">
            <IconLucide name={d.icon} size={18} class="info-ikona" />
            <div class="info-text">
              <span class="info-nazev">{d.nazev}</span>
              {Array.isArray(d.text) ? (
                <ul class="info-podbody">
                  {d.text.map((radek) => <li>{radek}</li>)}
                </ul>
              ) : (
                <p class="info-popis">{d.text}</p>
              )}
            </div>
          </li>
        ))}
      </ul>

      <div class="info-cta">
        <a href="#poptavka" class="btn btn-secondary">Poslat dotaz</a>
      </div>
    </div>

  </div>
</section>

<style>
  /* ---- Section band ---------------------------------------------------- */

  .podminky {
    background-color: var(--color-kamen);
  }

  /* ---- Head ------------------------------------------------------------ */

  .podminky-head {
    max-width: var(--container-prose);
  }

  h2 {
    /* --les on --kamen = 12.91:1 ✓ */
    color: var(--color-les);
  }

  /* ---- Steps list ------------------------------------------------------ */

  /*
   * Ordered list   the numbers are semantic (step 1, step 2, ...) and the
   * visual counter next to the icon reinforces that. Using `list-style: none`
   * here because we render the number ourselves inside `.krok-cislo`.
   *
   * Three steps: one column, then straight to three at 56rem. Two columns in
   * between would leave a lone card under a gap   the same 2+1 failure
   * Cenik.astro's season grid avoids.
   */
  .kroky {
    display: grid;
    gap: 1rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: krok;
  }

  @media (width >= 56rem) {
    .kroky {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  /* ---- Individual step card ------------------------------------------- */

  .krok {
    gap: 0.75rem;
  }

  .krok-hlava {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  /*
   * The step number   a small brass circle in the heading row. It pairs with
   * the icon so a reader who skims the headings can count the steps.
   */
  .krok-cislo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-mosaz);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    /* --omitka on --mosaz = 5.14:1 ✓   primary button pairing */
    color: var(--color-omitka);
    /* Tabular for the digit itself, but it's decorative here   no line-up needed. */
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .krok-ikona {
    flex: none;
    /* --mosaz-tmava on --omitka (card bg) = 6.05:1 ✓ */
    color: var(--color-mosaz-tmava);
  }

  /*
   * Step labels are UI labels, not headings in the display sense.
   * docs/02-design-system.md §2.6: Fraunces is "never for UI labels, never
   * below 20 px". Public Sans at body size matches how Ubytovani.astro uses
   * font-family: var(--font-body) on its table row headers.
   */
  .krok-nazev {
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: var(--font-weight-semibold);
    color: var(--color-les);
  }

  .krok-popis {
    font-size: var(--text-body);
    color: var(--color-kura);
    margin: 0;
    max-width: none;
    line-height: 1.6;
  }

  /* ---- Additional information panel ------------------------------------- */

  /*
   * No border: the colour shift alone   --omitka panel on this section's
   * --kamen ground   marks the boundary ("no border, or a border on every
   * side" is this page's rule; see Cenik.astro's header).
   */
  .info {
    margin-top: 3rem;
    padding: 1.5rem;
    background-color: var(--color-omitka);
    border-radius: var(--radius-sm);
  }

  @media (width >= 48rem) {
    .info {
      padding: 2rem 2.5rem;
      max-width: 46rem;
    }
  }

  .info-nadpis {
    font-size: var(--text-title-s);
    /* --mosaz-tmava on --omitka = 6.05:1 ✓ */
    color: var(--color-mosaz-tmava);
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .info-polozka {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: var(--text-body);
    line-height: 1.5;
  }

  .info-ikona {
    flex: none;
    margin-top: 0.15rem;
    /* --mosaz-tmava on --omitka = 6.05:1 ✓ */
    color: var(--color-mosaz-tmava);
  }

  .info-text {
    min-width: 0;
  }

  .info-nazev {
    font-weight: var(--font-weight-semibold);
    color: var(--color-les);
  }

  .info-popis {
    margin: 0.15rem 0 0;
    max-width: none;
    color: var(--color-kura);
  }

  .info-podbody {
    margin: 0.25rem 0 0;
    padding-left: 1.1rem;
    list-style: disc;
    color: var(--color-kura);
  }

  .info-podbody li + li {
    margin-top: 0.2rem;
  }

  /* ---- CTA ------------------------------------------------------------- */

  .info-cta {
    margin-top: 1.5rem;
  }

  /*
   * .btn-secondary on --omitka ground: transparent fill, --mosaz-tmava text
   * and --mosaz border. --mosaz-tmava on --omitka = 6.05:1 ✓.
   */
</style>
