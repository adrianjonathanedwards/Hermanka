---
/**
 * Silvestr a Vánoce   holiday blocks with self-expiring dates.
 *
 * ⚠ THE DATES ARE NULL AND MUST STAY NULL UNTIL THE CLIENT CONFIRMS THEM.
 *
 * The live site shows "Vánoce 23.-26.12.2024" next to the word "letos"   two
 * years stale at the time of writing. That is error #5 in docs/01-content.md §1,
 * and the clearest possible signal that a static date string in a heading will
 * eventually rot. The fix here is `jeAktualni()`: if `s.do` is null or in the
 * past, the block renders as an inquiry ("termín upřesníme   napište nám") and
 * no date appears at all. A stale offer is impossible to render. When the client
 * confirms dates for the coming season, set `od` and `do` in SVATKY in cenik.ts
 * and this template changes nothing.
 *
 * Prices ARE shown regardless of date status   they are confirmed figures from
 * the data module, and showing them helps the guest plan. But the specific dates
 * and (for Vánoce) the number of nights are TBD.
 *
 * Section band: --les (dark). Previous section (Ceník) is --kamen.
 * Text on --les uses --omitka (15.45:1 ✓). Brass text uses --mosaz-svetla
 * (6.19:1 on --les ✓). Cards use --kura ground (secondary dark).
 *
 * TODO(client)   docs/01-content.md §9 items 3 and 4 (LAUNCH-BLOCKING):
 *   item 3: Which nights for Vánoce in the coming season?
 *   item 4: Which three nights for Silvestr in the coming season?
 * Set od/do in cenik.ts once confirmed. Nothing here changes.
 */
import IconLucide from '../../IconLucide.astro';
import { SVATKY, jeAktualni, formatKc } from '../../../data/cenik';

/*
 * U+00A0   hard space. Typed as a constant so it cannot disappear in review.
 * docs/02-design-system.md §2.6.
 */
const NBSP = ' ';

const today = new Date();
---

<section class="section svatky" aria-labelledby="svatky-nadpis">
  <div class="wrap">

    <div class="svatky-head" data-reveal>
      <h2 id="svatky-nadpis">Silvestr a{NBSP}Vánoce</h2>
      <p class="lead">
        Speciální termíny se zvláštními cenami. Jakmile budeme mít konkrétní
        data potvrzená, zobrazí se tady.
      </p>
    </div>

    <ul class="svatky-list" data-reveal data-reveal-delay="60">
      {SVATKY.map((s) => {
        const aktualni = jeAktualni(s, today);
        return (
          <li class="svatek">

            <div class="svatek-hlava">
              <IconLucide name="calendar-days" size={22} class="svatek-ikona" />
              <h3>{s.nazev}</h3>
            </div>

            {/*
              Price is shown even when dates are pending   the figure is confirmed
              data from cenik.ts and helps the guest plan their budget. Duration is
              shown only when it is known (Silvestr has "3 noci", Vánoce does not
              yet). No number about money is written here; all values come through
              formatKc(). docs/01-content.md §2.
            */}
            {s.cena !== null && (
              <p class="svatek-cena">
                {formatKc(s.cena)}
                {s.delka !== null && (
                  <span class="svatek-delka">{NBSP}/ {s.delka}</span>
                )}
              </p>
            )}

            <p class="svatek-text">{s.text}</p>

            {aktualni && s.od && s.do ? (
              /*
               * Dates are confirmed and have not yet passed. Render them.
               * jeAktualni() returns true only when s.do is truthy and in the
               * future; the `&& s.od && s.do` guard narrows both to string so
               * TypeScript can verify the dateTime template literal is safe.
               */
              <p class="svatek-termin">
                <IconLucide name="calendar-days" size={16} class="termin-ikona" />
                {/*
                  TODO: when dates are first supplied in cenik.ts, add a Czech
                  date formatter here   ISO strings like "2025-12-28" are not
                  user-friendly in Czech. Format as "28. 12. 2025" before launch.
                */}
                {/*
                  `datetime`, lowercase. Astro's <time> is plain HTML, not JSX  
                  the React-style `dateTime` type-errors and would have shipped
                  a <time> element with no machine-readable value on it.
                */}
                <time datetime={`${s.od}/${s.do}`}>
                  {s.od}{NBSP}–{NBSP}{s.do}
                </time>
              </p>
            ) : (
              /*
               * No dates (null) or past dates. Renders as an invitation to write,
               * never as a stale year. This is the state both blocks are in at
               * launch. docs/01-content.md §1 error #5.
               */
              <div class="svatek-bez-terminu">
                <p class="upres">
                  Termín pro tuto sezonu upřesníme   napište{NBSP}nám.
                </p>
                <a href="#poptavka" class="btn btn-ghost">Napsat poptávku</a>
              </div>
            )}

          </li>
        );
      })}
    </ul>

  </div>
</section>

<style>
  /* ---- Section band ---------------------------------------------------- */

  /*
   * --les for the holiday section: a dark band for Silvestr and Vánoce
   * reads as occasion rather than information. Previous section (Ceník) is
   * --kamen; --les is different ✓.
   */
  .svatky {
    background-color: var(--color-les);
    color: var(--color-omitka);
  }

  /* ---- Head ------------------------------------------------------------ */

  .svatky-head {
    max-width: var(--container-prose);
  }

  h2 {
    /* --omitka on --les = 15.45:1 ✓ */
    color: var(--color-omitka);
  }

  .lead {
    margin-top: 1rem;
    font-size: var(--text-lead);
    /* --kamen on --les = 12.91:1 ✓ */
    color: var(--color-kamen);
  }

  /* ---- Card list ------------------------------------------------------- */

  .svatky-list {
    display: grid;
    gap: 1.5rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .svatky-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  /* ---- Individual holiday card ----------------------------------------- */

  /*
   * Cards sit on --kura (secondary dark) rather than the global .card class
   * (which hardcodes --omitka). On --les, --kura creates a subtle raised surface
   * while keeping the palette dark. --omitka on --kura = 11.92:1 ✓.
   */
  .svatek {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    /* Hairline border in white at low opacity   1px is permitted. */
    border: 1px solid rgb(251 250 248 / 0.14);
    border-radius: var(--radius-sm);
    background-color: var(--color-kura);
  }

  @media (width >= 48rem) {
    .svatek {
      padding: 1.75rem 2rem;
    }
  }

  /* ---- Card head ------------------------------------------------------- */

  .svatek-hlava {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .svatek-ikona {
    flex: none;
    /* --mosaz-svetla on --kura = 4.77:1 ✓   meets the 4.5:1 floor */
    color: var(--color-mosaz-svetla);
  }

  h3 {
    /* --omitka on --kura = 11.92:1 ✓ */
    color: var(--color-omitka);
    font-size: var(--text-title-s);
  }

  /* ---- Price ----------------------------------------------------------- */

  /*
   * Price at a prominent size. --mosaz-svetla on --kura = 4.77:1 ✓.
   * At --text-title-s (25px) this qualifies as "large text" under WCAG,
   * whose threshold is 18.66px / 14pt bold   4.77:1 > 4.5:1 ✓.
   * tabular-nums is already on the table element; this is a <p>, so we
   * apply it explicitly here.
   */
  .svatek-cena {
    font-size: var(--text-title-s);
    font-variant-numeric: tabular-nums;
    color: var(--color-mosaz-svetla);
    line-height: 1.3;
    margin: 0;
    max-width: none;
  }

  .svatek-delka {
    font-size: var(--text-body);
    /* --jinovatka on --kura = 9.39:1 ✓   legitimate winter accent on dark */
    color: var(--color-jinovatka);
    font-weight: var(--font-weight-normal);
  }

  /* ---- Description text ------------------------------------------------ */

  .svatek-text {
    font-size: var(--text-body);
    /* --kamen on --kura: kamen = #E8E6E0, kura = #3E3226   measured 9.96:1 ✓ */
    color: var(--color-kamen);
    margin: 0;
    max-width: none;
  }

  /* ---- When dates are confirmed ---------------------------------------- */

  .svatek-termin {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-body);
    font-variant-numeric: tabular-nums;
    color: var(--color-jinovatka);
    margin: 0;
    max-width: none;
  }

  .termin-ikona {
    flex: none;
    color: var(--color-jinovatka);
  }

  /* ---- "Termín upřesníme" state ---------------------------------------- */

  /*
   * This is the state both blocks are in at launch. It is not a placeholder
   * or a "coming soon" badge   it is a true statement that invites the guest
   * to write. The prior art (the live site's stale 2024 dates) is the reason
   * this branch exists.
   */
  .svatek-bez-terminu {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .upres {
    font-size: var(--text-body);
    font-style: italic;
    /* --jinovatka on --kura = 9.39:1 ✓ */
    color: var(--color-jinovatka);
    margin: 0;
    max-width: none;
  }

  /*
   * .btn-ghost is the appropriate button style on a dark ground:
   * transparent background, --omitka border and text (--omitka on --les 15.45:1).
   * .btn-secondary uses --mosaz-tmava which fails on --les at 3.00:1.
   */
</style>
