---
/**
 * Ceník   one plain list, seasons as rows, a real photograph per season.
 *
 * REDONE: was a `<table>` with a boxed, left-bordered note above it. Both are
 * gone. Every figure still comes from src/data/cenik.ts through formatKc()
 * the word "every" is absolute: no price, no per-person figure and no currency
 * amount may be typed into this file (docs/01-content.md §2, the four-year-old
 * hardcoded 311 Kč that stopped matching the price list is why this module
 * exists at all).
 *
 * ---------------------------------------------------------------------------
 * WHY A LIST OF ROWS, NOT A TABLE, AND NOT A CARD EACH
 *
 * Three seasons, four figures. A `<table>` was the right call over six cards
 * (docs/01-content.md §6.2), but a table has a second failure mode on a phone:
 * it either scrolls sideways or its columns collapse until the price and the
 * season that owns it are two thumb-widths apart. Three rows in a plain list,
 * each one a season name, its months, and its two prices, reflows on its own
 * terms instead   the price pair drops under the name on a narrow phone and
 * sits at the row's right edge everywhere wider, so the "prices must line up
 * and be COMPARABLE" property the table existed for survives without the
 * scroll wrapper.
 *
 * No card box around a row, either. `--color-omitka` fill and a hairline
 * border on three near-identical boxes said "these are three unrelated
 * offers"; three rows under one rule say what is actually true, that they are
 * one price list with three entries.
 *
 * ---------------------------------------------------------------------------
 * THE PHOTOGRAPHS
 *
 * One per season, all the client's own, all already used elsewhere on the
 * site: `dolnimorava.webp` (the ski slopes   Zimní sezona), `DSC_5189.webp`
 * (the garden table under full summer leaf   Letní sezona), `DSC_5228.webp`
 * (the cottage's own three-quarter exterior, in no particular season   Mimo
 * sezonu, which has no season of its own to photograph). They replace the note
 * box and the empty space a bare table left beside three rows of numbers   the
 * "use images" instruction was answered with real photographs of real seasons
 * here, not a stock photo of a calendar.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import IconLucide from '../../IconLucide.astro';
import type { LucideName } from '../../IconLucide.astro';
import { SEZONY, KAPACITA, formatKc, PRESNE_HRANICE_CHYBI, type Sezona } from '../../../data/cenik';
import zimniFoto from '@img/dolnimorava.webp';
import letniFoto from '@img/DSC_5189.webp';
import mimoFoto from '@img/DSC_5228.webp';

const SEZONA_FOTO: Record<Sezona['klic'], ImageMetadata> = {
  zimni: zimniFoto,
  letni: letniFoto,
  mimo: mimoFoto,
};

const SEZONA_IKONA: Record<Sezona['klic'], LucideName> = {
  zimni: 'snowflake',
  letni: 'sun',
  mimo: 'trees',
};

/*
 * U+00A0   hard space. Written as a constant so it cannot be mistaken for
 * an ordinary space in review or in edits. docs/02-design-system.md §2.6:
 * required between a numeral and its unit and after single-letter prepositions.
 */
const NBSP = ' ';
---

<section class="section cenik" aria-labelledby="cenik-nadpis">
  <div class="wrap">

    <div class="cenik-head" data-reveal>
      <p class="kapacita">
        {/*
          Hard spaces between every unit pair: "2 až 15 osob", "3 ložnice".
          docs/02-design-system.md §2.6.
        */}
        2{NBSP}až{NBSP}{KAPACITA}{NBSP}osob · 3{NBSP}ložnice
      </p>
      <h2 id="cenik-nadpis">Ceník</h2>
      <p class="lead">
        Ceny jsou za celou chalupu, ne za osobu. Počet hostů cenu nemění
        chalupa je k dispozici jako celek.
      </p>
    </div>

    <ul class="cenik-list" data-reveal data-reveal-delay="80" role="list" aria-describedby="cenik-pozn">
      {
        SEZONY.map((s) => (
          <li class="cenik-radek">
            <div class="cenik-media media-frame">
              <Image
                src={SEZONA_FOTO[s.klic]}
                alt=""
                widths={[96, 176, 288]}
                sizes="5rem"
                width={288}
                height={288}
                format="webp"
                quality={62}
                loading="lazy"
                class="cenik-foto"
              />
            </div>

            <div class="cenik-info">
              <h3 class="cenik-nazev">
                <IconLucide name={SEZONA_IKONA[s.klic]} size={16} class="cenik-ikona" />
                <span>{s.nazev}</span>
              </h3>
              <p class="cenik-obdobi">{s.obdobi}</p>
            </div>

            <div class="cenik-ceny">
              <div class="cenik-cena">
                <span class="cenik-cena-hodnota">{formatKc(s.tyden)}</span>
                <span class="cenik-cena-label">týden</span>
              </div>
              <div class="cenik-cena">
                <span class="cenik-cena-hodnota">{formatKc(s.vikend)}</span>
                <span class="cenik-cena-label">víkend</span>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    {/*
      Replaces the old boxed, left-bordered note. A plain line under the list,
      the same weight as the note under it   an honest caveat, not an alert.
      Conditional on the build-time flag: once the client supplies exact
      dates (docs/01-content.md §9 item 5), PRESNE_HRANICE_CHYBI flips to
      false and this disappears without touching the template.
    */}
    {
      PRESNE_HRANICE_CHYBI && (
        <p class="cenik-note">
          <IconLucide name="info" size={15} class="cenik-note-ikona" />
          {/*
            ⚠ Guest-facing copy, second person throughout   see the file's
            previous version for why "čeká na potvrzení od klienta" is wrong.
          */}
          Přesné hranice sezón ještě dolaďujeme, zatím platí přibližné
          vymezení z původního ceníku. Váš termín vám rádi potvrdíme předem,
          stačí napsat.
        </p>
      )
    }

    <p class="cenik-pozn" id="cenik-pozn">
      K ceně se připočítává elektřina dle spotřeby, voda a rekreační poplatek
      obci.{NBSP}Podrobnosti v{NBSP}přehledu poplatků níže.
    </p>

  </div>
</section>

<style>
  /* ---- Section band ---------------------------------------------------- */

  .cenik {
    background-color: var(--color-kamen);
  }

  /* ---- Head ------------------------------------------------------------ */

  .cenik-head {
    max-width: var(--container-prose);
  }

  /*
   * "2 až 15 osob · 3 ložnice"   styled as an eyebrow label in brass.
   * --mosaz-tmava on --kamen = 5.06:1 ✓ (docs/02-design-system.md §1.1)
   */
  .kapacita {
    display: block;
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-mosaz-tmava);
    margin-bottom: 0.5rem;
  }

  h2 {
    /* --les on --kamen = 12.91:1 ✓ */
    color: var(--color-les);
  }

  .lead {
    margin-top: 1rem;
    font-size: var(--text-lead);
    color: var(--color-kura);
  }

  /* ---- The list ---------------------------------------------------------
   *
   * Grid, not flex: `grid-template-areas` is what lets the price pair drop
   * onto its own row under the name on a narrow phone and rejoin the row at
   * its right edge from 40rem, with the photograph spanning both either way,
   * without a second breakpoint-specific markup structure.
   */
  .cenik-list {
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    max-width: 44rem;
  }

  .cenik-radek {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas: 'media info' 'media ceny';
    column-gap: 1rem;
    row-gap: 0.6rem;
    align-items: center;
    padding-block: 1.5rem;
  }

  .cenik-radek + .cenik-radek {
    /* Hairline between rows   the only rule this list has. */
    border-top: 1px solid rgb(62 50 38 / 0.14);
  }

  @media (width >= 40rem) {
    .cenik-radek {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: 'media info ceny';
      column-gap: 1.5rem;
    }
  }

  .cenik-media {
    grid-area: media;
    width: 4rem;
    aspect-ratio: 1;
  }

  @media (width >= 40rem) {
    .cenik-media {
      width: 5rem;
    }
  }

  /* `.media-frame` from global.css: square corners, --color-kamen fill while
     the photo loads. This section's own ground IS --color-kamen, so unlike
     OkoliKoupani.astro no override is needed   every row here has a real
     photo, and the fill is never seen once it loads. */
  .cenik-foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cenik-info {
    grid-area: info;
    min-width: 0;
  }

  .cenik-nazev {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: var(--font-weight-semibold);
    color: var(--color-les);
  }

  .cenik-ikona {
    flex: none;
    /* --mosaz-tmava on --kamen = 5.06:1 ✓ */
    color: var(--color-mosaz-tmava);
  }

  .cenik-obdobi {
    margin: 0.25rem 0 0;
    font-size: var(--text-caption);
    color: var(--color-kura);
    max-width: none;
  }

  .cenik-ceny {
    grid-area: ceny;
    display: flex;
    gap: 1rem;
  }

  @media (width >= 40rem) {
    .cenik-ceny {
      justify-self: end;
      text-align: right;
      gap: 2rem;
    }
  }

  .cenik-cena {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  @media (width >= 40rem) {
    .cenik-cena {
      align-items: flex-end;
    }
  }

  /*
   * ⚠ Smaller on a phone, on purpose. Two price figures share the row with a
   * photo, a name and a period there, and `--text-title-s` (the size used for
   * a single standalone figure elsewhere on the site) was 1px away from
   * forcing the page to scroll sideways at 375px   hard rule #13. Escalates
   * to the standalone size once the row has a third grid column to grow into.
   */
  .cenik-cena-hodnota {
    font-family: var(--font-display);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-body);
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    /* --mosaz-tmava on --kamen = 5.06:1 ✓ */
    color: var(--color-mosaz-tmava);
  }

  @media (width >= 40rem) {
    .cenik-cena-hodnota {
      font-size: var(--text-title-s);
    }
  }

  .cenik-cena-label {
    margin-top: 0.2rem;
    font-size: var(--text-caption);
    color: var(--color-kura);
  }

  /* ---- Season-boundary note ---------------------------------------------
   *
   * A plain line, not a box: see the header comment for why the old
   * left-bordered panel is gone. `info` in the same brass the rest of the
   * page's icons use, not a warning colour   this is an honest caveat, not
   * an error.
   */
  .cenik-note {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 2rem;
    max-width: 44rem;
    font-size: var(--text-caption);
    color: var(--color-kura);
  }

  .cenik-note-ikona {
    flex: none;
    margin-top: 0.15rem;
    /* --mosaz-tmava on --kamen = 5.06:1 ✓ */
    color: var(--color-mosaz-tmava);
  }

  /* ---- Note below the list ----------------------------------------------- */

  .cenik-pozn {
    margin-top: 0.75rem;
    font-size: var(--text-caption);
    color: var(--color-kura);
    max-width: 56ch;
  }
</style>
