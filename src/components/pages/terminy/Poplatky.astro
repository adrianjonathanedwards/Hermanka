---
/**
 * Co se připočítává   fee schedule.
 *
 * docs/01-content.md §6.4 (REWRITE): the old site buried all of this in a
 * 120-word run of prose   the guest found out about the electricity meter after
 * they had already decided. A visible list of line items makes each charge
 * visible and comparable at a glance.
 *
 * REDONE: was five bordered `.card` tiles in a grid. Five near-identical boxes
 * for five short line items was the same mistake the old ceník's six cards
 * were (see Cenik.astro's header comment)   a plain icon list says "these are
 * one list of charges" instead of "these are five separate offers." No card,
 * no border, anywhere in this file now; a two-column grid at wider viewports
 * groups the five items without boxing any of them.
 *
 * The POPLATKY array in cenik.ts is the single source of truth for this section.
 * Nothing about money is typed into this file (docs/01-content.md §2).
 *
 * ⚠ Two entries carry `nepotvrzeno: true`. They must be shown as approximate
 * rather than as confirmed prices   a guest who bases a budget on an unconfirmed
 * rate and finds a different one on arrival loses trust in everything on the page.
 * The unconfirmed badge and the TODO comments below track exactly which items
 * are waiting on the client.
 *
 * Formatting note: POPLATKY.castka is already a pre-formatted string with hard
 * spaces from cenik.ts, e.g. `7 Kč/kWh` (U+00A0 between 7 and Kč). Render it
 * directly; do not pass it through formatKc(), which expects a plain number.
 *
 * Section band: --omitka. Previous section (Svátky) is --les.
 *
 * TODO(client)   docs/01-content.md §9 item 7:
 *   · Electricity rate ("7 Kč/kWh" is from 2019   the old site says
 *     "momentálně", which is not a price).
 *   · Municipal recreation fee (4 Kč/os/noc is low for 2026; must be confirmed
 *     with the obec).
 *   Both are marked `nepotvrzeno: true` in cenik.ts and shown as such here.
 */
import IconLucide from '../../IconLucide.astro';
import { POPLATKY } from '../../../data/cenik';

/*
 * No `const NBSP` here, deliberately. Every string this section renders comes
 * out of POPLATKY in src/data/cenik.ts, and that module already binds its own
 * hard spaces   `7 Kč/kWh`, `2 000 Kč`. There is no free-typed numeral on this
 * page for one to go in, and an unused constant is an invitation to start
 * typing prices into the markup, which is the one thing this page must not do.
 */
---

<section class="section poplatky" aria-labelledby="poplatky-nadpis">
  <div class="wrap">

    <div class="poplatky-head" data-reveal>
      <h2 id="poplatky-nadpis">Co se připočítává</h2>
      <p class="lead">
        K ceně za pronájem se připočítávají tyto položky. Elektřina a voda se
        účtují podle skutečné spotřeby, ne paušálem.
      </p>
    </div>

    <ul class="poplatky-list" data-reveal data-reveal-delay="80" role="list">
      {POPLATKY.map((p) => (
        <li class="poplatek">
          <IconLucide name={p.icon} size={22} class="poplatek-ikona" />

          <div class="poplatek-text">
            <div class="poplatek-radek">
              <h3 class="poplatek-nazev">{p.nazev}</h3>
              <span class="poplatek-castka">{p.castka}</span>
              {p.nepotvrzeno && (
                /*
                 * Unconfirmed rate. Shown as "orientačně" (approx.) rather than
                 * silently presented as a confirmed price. See the TODO(client) in
                 * the file header   both items must be confirmed before launch.
                 *
                 * docs/01-content.md §6.4: `momentálně 7 Kč/kWh` is "not a price".
                 * That is the reason this badge exists. A guest who gets a surprise
                 * electricity bill also loses trust in the calendar, the price list
                 * and everything else on the page.
                 */
                <span class="badge-nepotvrzeno" aria-label="Orientační cena, čeká na potvrzení">
                  orientačně
                </span>
              )}
            </div>

            <p class="poplatek-popis">{p.popis}</p>
          </div>
        </li>
      ))}
    </ul>

    {/*
      The sauna and hot tub charge is listed above in POPLATKY, and this is the
      page that owns it: every figure about money is printed on /terminy-a-ceny
      and nowhere else, so there is one place to change a price.

      docs/01-content.md §4.7 also wants the charge visible beside the
      description of the sauna itself, which is the homepage's Wellness section.
      That is a cross-reference to add there, not a second copy of the number to
      keep in sync here.
    */}

  </div>
</section>

<style>
  /* ---- Section band ---------------------------------------------------- */

  .poplatky {
    background-color: var(--color-omitka);
  }

  /* ---- Head ------------------------------------------------------------ */

  .poplatky-head {
    max-width: var(--container-prose);
  }

  h2 {
    /* --mosaz-tmava on --omitka = 6.05:1 ✓ */
    color: var(--color-mosaz-tmava);
  }

  .lead {
    margin-top: 1rem;
    font-size: var(--text-lead);
    color: var(--color-kura);
  }

  /* ---- Fee list --------------------------------------------------------
   *
   * A plain two-column list, not a card grid   see the header comment. Items
   * are separated by generous gap alone, no rules and no boxes; five items in
   * two columns naturally sit as 3+2, which does not need a rule to look
   * intentional the way a card grid with a short last row can.
   */
  .poplatky-list {
    display: grid;
    gap: 1.75rem 2.5rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 40rem) {
    .poplatky-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---- Individual fee row ------------------------------------------------ */

  .poplatek {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
  }

  .poplatek-ikona {
    flex: none;
    margin-top: 0.15rem;
    /* --mosaz-tmava on --omitka = 6.05:1 ✓ */
    color: var(--color-mosaz-tmava);
  }

  .poplatek-text {
    min-width: 0;
  }

  /* ---- Name + amount row ------------------------------------------------- */

  .poplatek-radek {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.75rem;
    row-gap: 0.35rem;
  }

  /*
   * Fee labels   UI labels, not display headings.
   * docs/02-design-system.md §2.6: Fraunces "never for UI labels, never below
   * 20 px". Same reasoning as Ubytovani's tbody th using --font-body.
   */
  .poplatek-nazev {
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: var(--font-weight-semibold);
    /* --les on --omitka = 15.45:1 ✓ */
    color: var(--color-les);
  }

  /*
   * The amount is a string from cenik.ts that already contains tabular-spaced
   * numerals and hard spaces (e.g. "7 Kč/kWh"). global.css sets tabular-nums
   * on `table` but not on arbitrary elements; `.tabular` from global.css can be
   * added, or we set it explicitly here.
   */
  .poplatek-castka {
    font-size: var(--text-caption);
    font-variant-numeric: tabular-nums;
    font-weight: var(--font-weight-semibold);
    /* --mosaz-tmava on --omitka = 6.05:1 ✓ */
    color: var(--color-mosaz-tmava);
  }

  /* ---- Unconfirmed badge ----------------------------------------------- */

  /*
   * "orientačně"   approx. Distinguishes an unconfirmed figure from a confirmed
   * price. Two items carry this at launch: electricity rate and the municipal
   * recreation fee. Both must be confirmed with the client before the site goes
   * live (docs/01-content.md §9 item 7).
   *
   * Styled as a quiet label rather than a warning   the information is still
   * useful to the guest; it is just approximate, not wrong.
   */
  .badge-nepotvrzeno {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgb(140 99 24 / 0.35);
    background-color: var(--color-kamen);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-normal);
    /* --mosaz-tmava on --kamen = 5.06:1 ✓ */
    color: var(--color-mosaz-tmava);
    letter-spacing: 0.03em;
    vertical-align: middle;
  }

  /* ---- Description ---------------------------------------------------- */

  .poplatek-popis {
    font-size: var(--text-caption);
    color: var(--color-kura);
    margin: 0.35rem 0 0;
    max-width: none;
    line-height: 1.5;
  }
</style>
