---
/**
 * Transport and parking — section 8 on /chalupa (#doprava).
 *
 * Copy: docs/01-content.md §5.6. Conflict "3 to 4 cars" (§5.6) vs. "4 cars"
 * (§5.1 and brief) resolved in favour of the brief: "4 cars at the property,
 * more on the access road" (docs/04-pages.md section 8). The rest of the §5.6
 * text is KEPT unchanged.
 *
 * GPS: from src/data/site.ts SITE.gps.
 *
 * Public transport: bus 500 m, train 2 km — from DOSTUPNOST in src/data/okoli.ts.
 * Listed here as a brief note; the full distance table is in
 * DostupnostChalupa.astro below.
 *
 * Photo: situace2.webp — aerial view showing the cottage and its grounds.
 * Approximate resolution: 1206×903 px.
 */
import { Image } from 'astro:assets';
import situace from '@img/situace2.webp';
import { SITE, mapyUrl } from '../../../data/site';
---

<section id="doprava" class="section doprava-sekce" aria-labelledby="doprava-nadpis">
  <div class="wrap">
    <div class="doprava-grid">

      {/* ---- Text panel ------------------------------------------- */}
      <div class="doprava-text" data-reveal>
        <h2 id="doprava-nadpis">Doprava a&nbsp;parkování</h2>

        <p class="doprava-odst">
          K&nbsp;objektu vede příjezdová cesta dimenzovaná i&nbsp;na nákladní
          automobil. Přímo u&nbsp;objektu je parkoviště pro&nbsp;4&nbsp;auta.
          Další osobní automobily lze zaparkovat na příjezdové cestě.
        </p>

        {/* GPS coordinates with map link */}
        <div class="gps-blok" data-reveal data-reveal-delay="80">
          <p class="gps-label">GPS</p>
          <a
            href={mapyUrl}
            class="gps-odkaz link"
            target="_blank"
            rel="noopener noreferrer"
          >
            {SITE.gps.label}
            <span class="sr-only"> (otevře se v novém okně)</span>
          </a>
        </div>

        {/* Public transport */}
        <div class="mhd-blok" data-reveal data-reveal-delay="120">
          <h3>Veřejná doprava</h3>
          <ul class="mhd-list">
            <li>
              <span class="mhd-misto">Autobus</span>
              <span class="mhd-vzd">Zastávka Heřmanice 500&nbsp;m od chalupy</span>
            </li>
            <li>
              <span class="mhd-misto">Vlak</span>
              <span class="mhd-vzd">Stanice Prostřední Lipka 2&nbsp;km</span>
            </li>
          </ul>
        </div>
      </div>

      {/* ---- Aerial photo with grounds -------------------------- */}
      <figure class="doprava-foto" data-reveal data-reveal-delay="40">
        <div class="media-frame photo-frame">
          <Image
            src={situace}
            alt="Letecký pohled na areál chalupy Heřmanka: budova, terasa, parkoviště, jezírko, sauna a okolní les"
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 64rem) 46vw, 100vw"
            width={1206}
            height={903}
            format="webp"
            quality={70}
            loading="lazy"
          />
        </div>
        <figcaption>Areál chalupy Heřmanka z ptačí perspektivy</figcaption>
      </figure>

    </div>
  </div>
</section>

<style>
  .doprava-sekce {
    background-color: var(--color-omitka);
  }

  /* ---- Grid: text left, photo right ----------------------------------- */
  .doprava-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (width >= 64rem) {
    .doprava-grid {
      grid-template-columns: 1fr 1.15fr;
      gap: 4rem;
      align-items: start;
    }
  }

  /* ---- Text -------------------------------------------------------------- */
  h2 {
    /* --mosaz-tmava on --omitka = 6.05:1 */
    color: var(--color-mosaz-tmava);
    margin-bottom: 1.25rem;
  }

  h3 {
    /* --mosaz-tmava on --omitka = 6.05:1 */
    color: var(--color-mosaz-tmava);
    font-size: var(--text-title-s);
    margin-bottom: 0.75rem;
  }

  .doprava-odst {
    max-width: var(--container-prose);
  }

  /* GPS */
  .gps-blok {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(62 50 38 / 0.14);
  }

  .gps-label {
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    /* --kura on --omitka = 11.92:1 */
    color: var(--color-kura);
    margin-bottom: 0.25rem;
    max-width: none;
  }

  .gps-odkaz {
    font-size: var(--text-body);
    font-variant-numeric: tabular-nums;
  }

  /* Public transport */
  .mhd-blok {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(62 50 38 / 0.14);
  }

  .mhd-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mhd-list li {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
  }

  .mhd-misto {
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-body);
    /* --mosaz-tmava on --omitka = 6.05:1 */
    color: var(--color-mosaz-tmava);
    white-space: nowrap;
  }

  .mhd-vzd {
    font-size: var(--text-body);
  }

  /* ---- Photo -------------------------------------------------------- */
  .doprava-foto {
    margin: 0;
  }

  .doprava-foto :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.625rem;
    font-size: var(--text-caption);
    /* --kura on --omitka = 11.92:1 */
    color: var(--color-kura);
  }
</style>
