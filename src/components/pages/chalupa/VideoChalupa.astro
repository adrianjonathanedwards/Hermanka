---
/**
 * Video — section 7 on /chalupa (#video).
 *
 * YouTube ID: -U_w_kwtzjI (Chalupa Heřmanka).
 *
 * NO IFRAME — not on load, not on click.
 * Facade only: a poster image inside a link that opens YouTube in a new
 * window. Pattern from src/components/sections/GalerieTeaser.astro.
 *
 * Why no iframe: one embed is roughly 500 kB and several third-party origins,
 * which is five times the entire page budget (docs/03-tech.md §5). Opening
 * YouTube in a new window also gives the full player — captions, quality
 * selection, full screen, "add to watch later" — instead of a clipped widget.
 *
 * ⚠ /video/ 301-redirects to /chalupa#video (public/_redirects). The anchor
 * #video therefore MUST exist and MUST sit on a stable element.
 *
 * Poster: the living room with the fireplace — the same image as in
 * GalerieTeaser.astro, because the video shows the cottage interior and this
 * room represents it best.
 */
import { Image } from 'astro:assets';
import obyvak from '@img/DSC_4579-scaled-1-1.jpg';
import Icon from '../../Icon.astro';

const VIDEO_ID = '-U_w_kwtzjI';
---

<section id="video" class="section video-sekce" aria-labelledby="video-nadpis">
  <div class="wrap">
    <div class="video-grid">

      {/* ---- Description -------------------------------------------------- */}
      <div class="video-copy" data-reveal>
        <h2 id="video-nadpis">Chalupa na&nbsp;videu</h2>
        <p class="video-lead">
          Prohlédněte si vybavení chalupy a&nbsp;veškeré možnosti vyžití,
          které vám nabízí.
        </p>
      </div>

      {/*
        A link, not a button. href is the canonical YouTube URL.
        `target="_blank"` together with `rel="noopener noreferrer"` — the
        security standard for new windows. The accessible description combines
        the poster's alt text, the visible label, and the SR new-window warning.
      */}
      <a
        class="video-frame photo-frame"
        href={`https://www.youtube.com/watch?v=${VIDEO_ID}&autoplay=1`}
        target="_blank"
        rel="noopener noreferrer"
        data-reveal
        data-reveal-delay="80"
      >
        <Image
          src={obyvak}
          alt="Náhled videa o chalupě Heřmanka — obývák s krbem a jídelním stolem"
          widths={[420, 640, 960, 1280]}
          sizes="(min-width: 64rem) 56vw, 100vw"
          width={1920}
          height={1282}
          format="webp"
          layout="none"
          quality={68}
          loading="lazy"
        />

        {/* Overlay with play icon */}
        <span class="video-play">
          <span class="video-play-ring">
            <Icon name="prehrat" size={24} strokeWidth={1.5} />
          </span>
          <span>
            Přehrát video
            <span class="sr-only"> na YouTube (otevře se v novém okně)</span>
          </span>
        </span>
      </a>

    </div>
  </div>
</section>

<style>
  .video-sekce {
    background-color: var(--color-kamen);
  }

  /* ---- Grid: description left, video right --------------------------------- */
  .video-grid {
    display: grid;
    gap: 2rem;
  }

  @media (width >= 64rem) {
    .video-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: 4rem;
      align-items: center;
    }
  }

  /* ---- Description ------------------------------------------------------------- */
  h2 {
    /* --mosaz-tmava on --kamen = 5.06:1 */
    color: var(--color-mosaz-tmava);
  }

  .video-lead {
    margin-top: 1rem;
    font-size: var(--text-lead);
    max-width: 36ch;
  }

  /* ---- Video frame ------------------------------------------------------- */
  .video-frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-les);
    /* Rounded corners to set it apart from gallery photos */
    border-radius: var(--radius-sm);
  }

  .video-frame :global(img) {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  /* Overlay with icon and label */
  .video-play {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    /* scrim: --les at ~42 % */
    background-color: rgb(22 36 28 / 0.42);
    color: var(--color-omitka);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    transition: background-color 300ms var(--ease-out);
  }

  @media (hover: hover) {
    .video-frame:hover .video-play,
    .video-frame:focus-visible .video-play {
      background-color: rgb(22 36 28 / 0.26);
    }
  }

  /* Ring around the play icon */
  .video-play-ring {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.75rem;
    height: 3.75rem;
    border: 2px solid var(--color-omitka);
    border-radius: var(--radius-pill);
    transition:
      transform 380ms var(--ease-spring),
      background-color 300ms var(--ease-out),
      border-color 300ms var(--ease-out);
  }

  @media (hover: hover) {
    .video-frame:hover .video-play-ring,
    .video-frame:focus-visible .video-play-ring {
      transform: scale(1.08);
      background-color: var(--color-mosaz);
      border-color: var(--color-mosaz);
    }
  }

  /*
   * ⚠ THERE WAS AN INFINITE PULSE RING ON THIS BUTTON AND IT WAS REMOVED.
   *
   * A second ring expanding out of the play mark every 2.8 seconds, forever,
   * gated behind `prefers-reduced-motion` and therefore technically legal. It
   * still had to go, for the reason written at the top of src/components/Icon.astro
   * when the same thing was taken off the amenity glyphs: something moving on
   * its own, permanently, with nothing having asked it to, is a page decorating
   * itself — and it is the clearest single sign that nobody chose any of it.
   *
   * The play mark does not need to attract attention. It is a white ring with a
   * triangle in it, centred on a photograph, and every reader on earth knows
   * what it does. The hover above is the whole interaction.
   */
</style>
