---
/**
 * V okolí naleznete — section 10 on /chalupa.
 *
 * Distance table from the cottage. Data: src/data/okoli.ts DOSTUPNOST.
 *
 * This table is, per the content audit, "quietly the most useful content on
 * the site." One row in it — „Les — 10 metrů, hned za chalupou" — is
 * "the best line on the entire website". docs/01-content.md §5.2.
 *
 * The forest entry is first deliberately: 10 metres is the answer to the
 * question every guest with children or a dog asks first. The forest row
 * gets visual emphasis.
 *
 * ⚠ Králíky is 3 km according to the table and 7 km on the illustrated
 *    map — an unresolved conflict (docs/01-content.md §9). If this page
 *    shows both, it must not draw attention to the discrepancy. Here we
 *    show only the table; the map is elsewhere.
 */
import { DOSTUPNOST } from '../../../data/okoli';
import IconLucide from '../../IconLucide.astro';
---

<section class="section dostupnost-sekce" aria-labelledby="dostupnost-nadpis">
  <div class="wrap">
    <div class="dostupnost-head" data-reveal>
      <h2 id="dostupnost-nadpis">V&nbsp;okolí naleznete</h2>
      <p class="dostupnost-intro">
        Vzdálenosti pěšky nebo vzdušnou čarou, pokud není uvedeno jinak.
      </p>
    </div>

    <ul class="dostupnost-list">
      {DOSTUPNOST.map((d, i) => {
        const jesPrvni = i === 0; /* Les — 10 metrů */
        return (
          <li
            class:list={['dostupnost-polozka', { 'dostupnost-polozka--les': jesPrvni }]}
            data-reveal
            data-reveal-delay={String(Math.min(i * 40, 200))}
          >
            <span class="d-ikona" aria-hidden="true">
              <IconLucide name={d.icon} size={22} strokeWidth={1.5} />
            </span>
            <span class="d-co">{d.co}</span>
            <span class="d-kde">{d.kde}</span>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .dostupnost-sekce {
    background-color: var(--color-omitka);
  }

  /* ---- Header ----------------------------------------------------------- */
  .dostupnost-head {
    margin-bottom: 2.5rem;
  }

  h2 {
    /* --mosaz-tmava on --omitka = 6.05:1 */
    color: var(--color-mosaz-tmava);
  }

  .dostupnost-intro {
    margin-top: 0.75rem;
    font-size: var(--text-caption);
    /* --kura on --omitka = 11.92:1 */
    color: var(--color-kura);
  }

  /* ---- Distance table ----------------------------------------------- */
  .dostupnost-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /*
   * Each row is three columns: icon | what | where. `grid-template-columns`
   * keeps alignment across all rows regardless of text length.
   */
  .dostupnost-polozka {
    display: grid;
    grid-template-columns: 2rem 8rem 1fr;
    gap: 0 1rem;
    align-items: baseline;
    padding-block: 0.875rem;
    border-bottom: 1px solid rgb(62 50 38 / 0.12);
  }

  .dostupnost-polozka:first-child {
    border-top: 1px solid rgb(62 50 38 / 0.12);
  }

  @media (width >= 48rem) {
    .dostupnost-polozka {
      grid-template-columns: 2rem 10rem 1fr;
    }
  }

  .d-ikona {
    display: flex;
    align-items: center;
    /* --mosaz on --omitka: 5.14:1 — used as a fill, not text */
    color: var(--color-mosaz);
    margin-top: 0.1rem;
  }

  .d-co {
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-body);
    /* --les on --omitka = 15.45:1 */
    color: var(--color-les);
  }

  .d-kde {
    font-size: var(--text-body);
    font-variant-numeric: tabular-nums;
    /* --kura on --omitka = 11.92:1 */
    color: var(--color-kura);
  }

  /*
   * „Les — 10 metrů, hned za chalupou" — the best line on the whole website
   * (docs/01-content.md §5.2). Gets visual emphasis: bold weight and
   * brass colour on both the name and the value.
   *
   * ⚠ This is not decoration: for a family with children or a dog it is the
   *    first question, not the fifth. The answer must be visible.
   */
  .dostupnost-polozka--les {
    padding-block: 1.25rem;
  }

  .dostupnost-polozka--les .d-co {
    font-size: var(--text-lead);
    /* --mosaz-tmava on --omitka = 6.05:1 */
    color: var(--color-mosaz-tmava);
  }

  .dostupnost-polozka--les .d-kde {
    font-size: var(--text-lead);
    font-weight: var(--font-weight-semibold);
    /* --les on --omitka = 15.45:1 */
    color: var(--color-les);
  }

  .dostupnost-polozka--les .d-ikona {
    /* --mosaz-tmava for the featured row */
    color: var(--color-mosaz-tmava);
  }
</style>
