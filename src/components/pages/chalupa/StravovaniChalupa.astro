---
/**
 * Dining — section 9 on /chalupa.
 *
 * Data: src/data/okoli.ts STRAVOVANI. Three third-party businesses last
 * verified in 2019; flagged with a caveat in the data and here.
 *
 * TODO(client) — docs/01-content.md §9 item 19: Is the farm still open?
 * Does the guesthouse serve food? Is Kačenka restaurant still running?
 * Three businesses in three sentences, last updated 2019.
 */
import { STRAVOVANI } from '../../../data/okoli';
import IconLucide from '../../IconLucide.astro';
---

<section class="section stravovani-sekce" aria-labelledby="stravovani-nadpis">
  <div class="wrap">
    <div class="stravovani-head" data-reveal>
      <h2 id="stravovani-nadpis">Stravování v&nbsp;okolí</h2>
      <p class="stravovani-intro">
        Pro skupinu vaříte nejraději sami — chalupa má plně vybavenou kuchyni.
        Pokud chcete jít ven, máte hned za rohem tyto možnosti.
      </p>
    </div>

    <ul class="stravovani-list">
      {STRAVOVANI.map((s, i) => (
        <li class="stravovani-item card" data-reveal data-reveal-delay={String(i * 70)}>
          <div class="stravovani-ikona" aria-hidden="true">
            <IconLucide name={s.icon} size={26} strokeWidth={1.5} />
          </div>
          <div class="stravovani-info">
            <p class="stravovani-nazev">{s.nazev}</p>
            <p class="stravovani-popis">{s.popis}</p>
            {s.vzdalenost && (
              <p class="stravovani-vzd"><span class="chip">{s.vzdalenost}</span></p>
            )}
          </div>
        </li>
      ))}
    </ul>

    {/*
      TODO(client) — docs/01-content.md §9 item 19. Verify that the farm,
      the guesthouse, and Kačenka restaurant are still operating before launch.
    */}
    <p class="stravovani-pozn" data-reveal>
      Informace o&nbsp;stravování pochází z&nbsp;roku 2019 — doporučujeme
      předem ověřit aktuální provoz.
    </p>
  </div>
</section>

<style>
  .stravovani-sekce {
    background-color: var(--color-kamen);
  }

  /* ---- Header ----------------------------------------------------------- */
  .stravovani-head {
    margin-bottom: 2.5rem;
  }

  h2 {
    /* --mosaz-tmava on --kamen = 5.06:1 */
    color: var(--color-mosaz-tmava);
  }

  .stravovani-intro {
    margin-top: 1rem;
    font-size: var(--text-lead);
    max-width: 48ch;
  }

  /* ---- Cards ------------------------------------------------------------ */
  .stravovani-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (width >= 40rem) {
    .stravovani-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .stravovani-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .stravovani-item {
    /* `.card` from global.css: --omitka background, border, border-radius */
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1.25rem 1.25rem 1.25rem 1rem;
  }

  .stravovani-ikona {
    /* --mosaz-tmava on --omitka = 6.05:1 */
    color: var(--color-mosaz-tmava);
    padding-top: 0.15rem;
  }

  .stravovani-nazev {
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-body);
    /* --les on --omitka = 15.45:1 */
    color: var(--color-les);
    margin-bottom: 0.25rem;
    max-width: none;
  }

  .stravovani-popis {
    font-size: var(--text-body);
    /* --kura on --omitka = 11.92:1 */
    color: var(--color-kura);
    max-width: none;
  }

  .stravovani-vzd {
    display: inline-flex;
    margin-top: 0.625rem;
  }

  /* Note below the cards */
  .stravovani-pozn {
    margin-top: 2rem;
    font-size: var(--text-caption);
    /* --kura on --kamen = 9.96:1 */
    color: var(--color-kura);
  }
</style>
