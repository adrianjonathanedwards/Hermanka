---
/**
 * Facts strip. The eight things that decide it, in one row.
 *
 * ONE ROW ON A PHONE, AND IT MOVES
 * --------------------------------
 * Eight items will not sit across 390px, so below the tablet break the row
 * becomes a carousel: one track, drifting left at reading pace, seamless.
 *
 * This is by request, and it is a knowing exception to docs/02-design-system.md
 * §5.3 — the same exception the hero carousel already runs under. What the rule
 * is protecting against is content nobody can reach: a marquee that hides half
 * its items behind a swipe most people never make. This one cannot, because
 * nothing is behind anything. Every fact comes past on its own, in order, and
 * the loop is short enough (about three quarters of a minute) that a reader who
 * stops on the section sees all eight without doing a thing.
 *
 * Above 48rem the eight fit across the container and the row stands still, which
 * is what the section was and still is on any screen with room for it.
 *
 * HOW THE LOOP IS BUILT
 * ---------------------
 * The list is rendered twice inside one flex track and the track is translated
 * by exactly -50%, so the moment the first copy has left the frame the second is
 * standing precisely where the first began and the animation restarts with
 * nothing to see. The second copy is `aria-hidden` — it is the same eight facts,
 * and a screen reader must be read them once.
 *
 * ⚠ The -50% only lands if the two copies are the SAME WIDTH, which is why the
 * gap between items is carried as `padding-inline-end` on each list rather than
 * as a `gap` on the track. A gap on the track would sit between the copies and
 * not after the second one, and half of that gap would show up as a stutter at
 * every seam.
 *
 * Icons are Lucide (see IconLucide.astro), not the drawn set — a premade family
 * of eight is internally consistent in a way eight bespoke glyphs were not.
 */
import IconLucide, { type LucideName } from '../IconLucide.astro';

const NBSP = ' ';

const fakta: { icon: LucideName; label: string }[] = [
  { icon: 'users', label: `15${NBSP}osob` },
  { icon: 'bed-double', label: `3${NBSP}ložnice` },
  { icon: 'flame-kindling', label: 'Sauna' },
  { icon: 'waves-ladder', label: 'Vířivka' },
  { icon: 'brick-wall-fire', label: `2${NBSP}krby` },
  { icon: 'waves', label: 'Jezírko' },
  // TODO(client): pets are listed as allowed in the old amenity list but the
  // terms are silent — any charge, any limit? docs/01-content.md §9 item 12.
  { icon: 'dog', label: 'Pes vítán' },
  // TODO(client) — LAUNCH-BLOCKING, docs/01-content.md §9 item 2.
  // `bezbariérové ubytování` is claimed in the old amenity list for a two-storey
  // cottage on a forested slope with two mezzanine bedrooms. The ground floor does
  // have a bedroom, a WC and a shower, so there may be a narrower claim that is
  // true — but it must be stated precisely, not as a tick-box. A wrong access
  // claim on a booking site ends with someone at a door they cannot get through.
  { icon: 'accessibility', label: 'Bezbariérový přístup' },
];
---

<section class="fakta" aria-labelledby="fakta-nadpis">
  <h2 id="fakta-nadpis" class="sr-only">Co chalupa nabízí</h2>

  <div class="fakta-viewport">
    <div class="fakta-track">
      <ul class="fakta-list">
        {
          fakta.map((f) => (
            <li class="fact">
              <IconLucide name={f.icon} class="fact-icon" />
              <span>{f.label}</span>
            </li>
          ))
        }
      </ul>

      {/* The seam. Same eight, announced once — see the note at the top. */}
      <ul class="fakta-list fakta-klon" aria-hidden="true">
        {
          fakta.map((f) => (
            <li class="fact">
              <IconLucide name={f.icon} class="fact-icon" />
              <span>{f.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .fakta {
    background-color: var(--color-kamen);
    padding-block: 1.75rem;
  }

  @media (width >= 48rem) {
    .fakta {
      padding-block: 2.25rem;
    }
  }

  .fakta-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ---- Phone: one row, drifting ------------------------------------------
   *
   * Written as its own `width < 48rem` block rather than as the mobile-first
   * base, because the two layouts share almost nothing: one is a track wider
   * than the screen inside a clipped frame, the other is a row that fits. Half
   * of each would otherwise spend its life being unset by the other.
   */
  @media (width < 48rem) {
    .fakta-viewport {
      overflow: hidden;
      /*
       * Items are not cut off at the edges, they fade out of the band. The stops
       * are the page gutter (1.5rem), so a fact is fully opaque exactly where
       * every other section's text begins.
       */
      -webkit-mask-image: linear-gradient(
        to right,
        transparent,
        #000 1.5rem,
        #000 calc(100% - 1.5rem),
        transparent
      );
      mask-image: linear-gradient(
        to right,
        transparent,
        #000 1.5rem,
        #000 calc(100% - 1.5rem),
        transparent
      );
    }

    .fakta-track {
      display: flex;
      /* Both copies at their natural width — never the frame's. */
      width: max-content;
      animation-name: fakta-drift;
      animation-duration: 46s;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }

    /*
     * The list's own padding IS the gap over the seam: 0.5rem off the end of one
     * copy plus 1.5rem off the start of the next makes the same 2rem that
     * separates every other pair. Split that way rather than 2rem on one side,
     * because the 1.5rem is doing a second job — it is the page gutter, so the
     * first fact starts level with every other section's text on the first paint
     * instead of already half inside the fade.
     */
    .fakta-list {
      flex: none;
      gap: 2rem;
      padding-inline: 1.5rem 0.5rem;
    }

    /* Rest a finger on it and it stops. Pointer devices get the same on hover. */
    .fakta-viewport:active .fakta-track {
      animation-play-state: paused;
    }

    @media (hover: hover) {
      .fakta-viewport:hover .fakta-track {
        animation-play-state: paused;
      }
    }
  }

  @keyframes fakta-drift {
    to {
      /* Exactly one copy. The other is already standing here. */
      transform: translate3d(-50%, 0, 0);
    }
  }

  /*
   * Reduced motion. The global clamp in global.css would run the drift once in
   * 0.01ms and drop the track back at the start — not broken, but then the last
   * five facts would be unreachable, so the row is handed over to the reader
   * instead: same single row, swiped rather than driven, snapping as it goes.
   *
   * Scoped to the phone block's own conditions so it cannot reach the static
   * row above 48rem, which has no motion to reduce.
   */
  @media (width < 48rem) and (prefers-reduced-motion: reduce) {
    .fakta-viewport {
      overflow-x: auto;
      scroll-snap-type: x proximity;
      /* No scrollbar under a row of icons — the fade is the affordance. */
      scrollbar-width: none;
    }

    .fakta-viewport::-webkit-scrollbar {
      display: none;
    }

    .fakta-track {
      animation-name: none;
    }

    .fakta-klon {
      display: none;
    }

    .fakta-list {
      padding-inline: 1.5rem;
    }

    .fact {
      scroll-snap-align: center;
    }
  }

  /* ---- Tablet and up: the row that fits ---------------------------------- */

  @media (width >= 48rem) {
    /* Replaces `.wrap` on the list. The container has to be the element that
       clips on a phone, and that element cannot also be carrying gutters. */
    .fakta-viewport {
      width: 100%;
      max-width: var(--container-site);
      margin-inline: auto;
      padding-inline: 2rem;
    }

    .fakta-list {
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 1.25rem 2.5rem;
    }

    .fakta-klon {
      display: none;
    }
  }

  .fact {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    white-space: nowrap;
    font-size: var(--text-caption);
    /* --les on --kamen = 12.91:1 */
    color: var(--color-les);
  }

  @media (width >= 64rem) {
    .fact {
      font-size: var(--text-body);
    }
  }

  .fact-icon {
    flex: none;
    /* --mosaz-tmava on --kamen = 5.06:1. Decorative here, but it sits beside
       text at the same size and must not read as disabled. */
    color: var(--color-mosaz-tmava);
  }
</style>
