---
/**
 * Wellness.
 *
 * The current site sets this copy in white over an underexposed winter photograph
 * and it is effectively unreadable. Not reproduced: the text sits on a solid --les
 * panel beside the photograph instead, giving --omitka on --les at 15.45:1 against
 * the 4.5:1 floor — no scrim, no gradient, nothing that depends on which part of a
 * photograph happens to be behind a given line.
 */
import { Image } from 'astro:assets';
import virivka from '@img/DSC_4684-scaled-1.jpg';
---

<section class="split split--media-left wellness" aria-labelledby="wellness-nadpis">
  <div class="split-media photo-frame" data-reveal="wipe">
    <Image
      src={virivka}
      alt="Dřevěná vířivka s vyhřívanými schody na terase, kolem dokola vzrostlý les"
      widths={[640, 960, 1280]}
      sizes="(min-width: 64rem) 50vw, 100vw"
      width={1920}
      height={1282}
      format="webp"
      quality={62}
      loading="lazy"
    />
  </div>

  <div class="split-body">
    <div data-reveal="up">
      <h2 id="wellness-nadpis">Venkovní sauna, jezírko, HotTube a venkovní posezení</h2>
      <p>
        Dopřejte si dokonalý relax v naší venkovní sauně s výhledem do přírody.
        Po saunování se můžete osvěžit v jezírku nebo si užít teplou lázeň v dřevěném
        HotTube pod širým nebem. K dispozici je také venkovní posezení, kde si můžete
        vychutnat klid a pohodu v jedinečném horském prostředí.
      </p>

    </div>
  </div>
</section>

<style>
  /*
   * The stone from the section above, carried on past the join.
   *
   * The photograph is inset 4rem from the top of this section (see below), and
   * that strip was showing page white directly under the stone band the section
   * above ends with — a colour change on the section line, which is the one
   * place it gets noticed. So the stone is painted on for the first 8rem of this
   * section instead. Nothing moves: the change now happens at 8rem, which is
   * 4rem BEHIND the top edge of the photograph, where nothing can see it.
   *
   * 8rem and not 4rem on purpose. Landing the stop exactly on the photograph's
   * edge would leave it to subpixel rounding whether a hairline of one colour or
   * the other shows at that line.
   *
   * The bottom strip is left as page white deliberately — it runs into the page
   * ground the next section sits on, so there is no change to hide there.
   */
  .wellness {
    background-image: linear-gradient(to bottom, var(--color-kamen) 0 8rem, transparent 8rem);
  }

  .wellness .split-body {
    /* Solid ground, not a scrim over a photograph. */
    background-color: var(--color-les);
    color: var(--color-omitka);
  }

  @media (width >= 64rem) {
    .wellness .split-body {
      /* Panel fills its half of the split so the colour block reads as deliberate. */
      align-self: stretch;
      display: flex;
      align-items: center;
      padding-block: 5rem;
    }

    /*
     * The dark panel stands 4rem PROUD OF THE PHOTOGRAPH AT BOTH ENDS.
     *
     * The two halves used to begin and finish on the same two lines, which is
     * the flattest thing a split can do. Now the panel is the full height of the
     * row and the picture is inset inside it, so the colour block overhangs the
     * photograph top and bottom and the page ground shows through in a strip at
     * each end of the left-hand column.
     *
     * By decision, and it costs one thing worth knowing: the section above ends
     * in the stone band, so the top strip puts a band of page white between that
     * stone and the top of the photograph. Deliberate. Do not "fix" it by
     * dropping the top margin — the symmetry is the point.
     *
     * `align-self: stretch` is what gives the photograph column a definite
     * height, and that is load-bearing twice over: it is what the margins
     * subtract from, and it is what lets `height: 100%` on the image resolve at
     * all. Without it the column is centred at the picture's own aspect ratio and
     * neither the offset nor the crop happens. See the same trap, from the other
     * side, in DolniMorava.astro.
     */
    .wellness .split-media {
      align-self: stretch;
      margin-block: 4rem;
    }

    /*
     * A wider measure than the 34rem `.split-body` gives every other split.
     *
     * The panel is half the viewport and its copy was stopping about 6rem short
     * of its own padding, so the block of text sat in the left two thirds of a
     * dark rectangle with the rest empty. 40rem is what fills the column at a
     * laptop width, and it is still inside the 65ch ceiling docs §3 puts on body
     * copy: this paragraph is set at --text-lead, where 40rem comes out around
     * 60 characters.
     */
    .wellness .split-body > * {
      max-width: 40rem;
    }
  }

  h2 {
    /* --omitka on --les = 15.45:1 */
    color: var(--color-omitka);
  }

  p {
    margin-top: 1.5rem;
    font-size: var(--text-lead);
    /* --jinovatka on --les = 12.17:1 */
    color: var(--color-jinovatka);
  }

  /*
   * A step up the scale for both, on this section only.
   *
   * The panel is half the viewport and it is the one place on the page where the
   * type has a dark ground the full height of the section to fill; at the page's
   * default sizes it sat in the middle of it looking like a caption. Heading to
   * --text-display, the h1 step, and the paragraph to --text-title-s.
   *
   * ⚠ Both are steps ON the scale in docs §2.4, not numbers picked to look right.
   * That is the only legal way to resize type here — a `clamp()` full of magic
   * rem values is what the rule exists to stop.
   *
   * ≥64rem only. Below it the heading already fills the measure at the default
   * size, and 49px would put this one four lines deep on a phone.
   *
   * Line heights come down as the sizes go up: the tokens' own 1.15 and 1.6 are
   * set for 39px and 20px, and left alone they read as gaps at 49 and 25.
   *
   * ⚠ THIS BLOCK MUST STAY BELOW THE TWO RULES ABOVE. It was written into the
   * earlier `@media (width >= 64rem)`, which sits above them — and a media query
   * adds no specificity, so the plain `p` rule's `font-size: var(--text-lead)`
   * simply won on source order and the paragraph never moved. The heading did,
   * which is exactly the sort of half-working that takes a while to spot.
   */
  @media (width >= 64rem) {
    h2 {
      font-size: var(--text-display);
      line-height: 1.1;
    }

    p {
      font-size: var(--text-title-s);
      line-height: 1.45;
    }
  }
</style>
