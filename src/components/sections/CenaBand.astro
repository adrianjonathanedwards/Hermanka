---
/**
 * Price band.
 *
 * Both figures are DERIVED from src/data/cenik.ts, not typed in. The current site
 * hardcodes "311 Kč na noc za osobu" into the markup and it has not matched the
 * price list for years (docs/01-content.md §2). The per-person figure here is a
 * rounded approximation shown underneath the whole-cottage price, never as the
 * headline claim, and always next to the note about what it excludes.
 *
 * ⚠ The price does NOT count up. docs/02-design-system.md §5.3 bans it and the
 * ban is right: a number that is still moving is a number that cannot be read,
 * and this one is the single most consequential figure on the page. Everything
 * around it moves; the price arrives finished.
 */
import { OD_VIKEND, ZA_OSOBU_NOC, formatKc } from '../../data/cenik';
---

<section class="cena" aria-labelledby="cena-nadpis">
  <div class="cena-glow" aria-hidden="true"></div>

  <div class="wrap cena-inner">
    <div data-reveal="up">
      <h2 id="cena-nadpis">Za víkend od {formatKc(OD_VIKEND)} za celou chalupu</h2>
    </div>

    <p class="cena-sub" data-reveal="up" data-reveal-delay="90">
      Při plném obsazení vychází noc na zhruba {formatKc(ZA_OSOBU_NOC)} na osobu.
    </p>

    <p class="cena-note" data-reveal="up" data-reveal-delay="150">
      K ceně se připočítává elektřina dle spotřeby, voda a rekreační poplatek obci.
    </p>

    <div data-reveal="up" data-reveal-delay="210">
      <a href="/terminy-a-ceny" class="btn btn-primary cena-cta">
        Přejít na ceny
      </a>
    </div>
  </div>
</section>

<style>
  .cena {
    position: relative;
    background-color: var(--color-les);
    color: var(--color-omitka);
    padding-block: 4rem;
    text-align: center;
    overflow: hidden;
  }

  @media (width >= 48rem) {
    .cena {
      padding-block: 6rem;
    }
  }

  /*
   * A brass wash behind the figure. One palette colour fading to nothing   not a
   * new hue, and nothing sits on top of it that has to clear a contrast floor:
   * at its strongest it is --mosaz at 14 % over --les, which moves the ground
   * measurably less than the photographs elsewhere on the page do.
   */
  .cena-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      60% 70% at 50% 30%,
      rgb(140 99 24 / 0.14) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .cena-inner {
    position: relative;
  }

  .cena-inner > * {
    margin-inline: auto;
  }

  h2 {
    max-width: 20ch;
    margin-inline: auto;
    /* --omitka on --les = 15.45:1 */
    color: var(--color-omitka);
  }

  .cena-sub {
    max-width: 40ch;
    margin-top: 1.25rem;
    font-size: var(--text-lead);
  }

  .cena-note {
    max-width: 46ch;
    margin-top: 1.25rem;
    font-size: var(--text-caption);
    /* --jinovatka on --les = 12.17:1 */
    color: var(--color-jinovatka);
  }

  .cena-cta {
    margin-top: 2.5rem;
  }
</style>
