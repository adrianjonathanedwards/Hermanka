---
/**
 * Price band   now just the way through to /terminy-a-ceny.
 *
 * It used to headline "Za víkend od 13 000 Kč za celou chalupu", a derived
 * per-person figure and a note on what is charged on top. The client asked for
 * all three to go (September 2026) and for the button alone to stay, so every
 * price is read on /terminy-a-ceny, next to its conditions. `OD_VIKEND` and
 * `ZA_OSOBU_NOC` in src/data/cenik.ts are still there if the headline returns.
 *
 * The <h2> stays for screen readers so the section keeps its name.
 */
---

<section class="cena" aria-labelledby="cena-nadpis">
  <div class="cena-glow" aria-hidden="true"></div>

  <div class="wrap cena-inner">
    <h2 id="cena-nadpis" class="sr-only">Ceny</h2>

    <div data-reveal="up">
      <a href="/terminy-a-ceny" class="btn btn-primary">
        Přejít na ceny
      </a>
    </div>
  </div>
</section>

<style>
  .cena {
    position: relative;
    background-color: var(--color-les);
    color: var(--color-omitka);
    padding-block: 3rem;
    text-align: center;
    overflow: hidden;
  }

  @media (width >= 48rem) {
    .cena {
      padding-block: 4rem;
    }
  }

  /*
   * A brass wash behind the button. One palette colour fading to nothing   not
   * a new hue; at its strongest it is --mosaz at 14 % over --les.
   */
  .cena-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      60% 70% at 50% 50%,
      rgb(140 99 24 / 0.14) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .cena-inner {
    position: relative;
  }
</style>
