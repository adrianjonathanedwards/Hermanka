---
/**
 * The inquiry section   a band, a heading, and the form.
 *
 * The form itself moved to PoptavkaForm.astro when the subpages were built: it is
 * on `/`, `/terminy-a-ceny` and `/kontakt`, and docs/04-pages.md requires those
 * last two to use the same component. This file is what stays page-shaped   the
 * band colour and the words above the card, which are the parts that legitimately
 * differ between "here is the whole homepage argument, now write to us" and "you
 * have just read the price list, now write to us".
 *
 * Defaults are the homepage's, so index.astro passes nothing.
 *
 * ⚠ `band` exists because docs/02-design-system.md §3 forbids two identical
 * bands adjacent. On `/terminy-a-ceny` the section above this one is already
 * stone, so that page passes `band="omitka"`.
 */
import PoptavkaForm from '../PoptavkaForm.astro';

interface Props {
  /** The <h2>. */
  nadpis?: string;
  /** One or two sentences under it. */
  lead?: string;
  /** Anchor id. `#poptavka` is linked from the footer on every page   keep it. */
  id?: string;
  /** Which band this sits on. Never the same as the section directly above. */
  band?: 'kamen' | 'omitka';
}

const {
  nadpis = 'Napište si o termín',
  lead = 'Napište nám termín a počet osob a my se vám co nejdříve ozveme s dostupností a přesnou cenou. Nezávazně.',
  id = 'poptavka',
  band = 'kamen',
} = Astro.props;
---

<section class:list={['section', 'poptavka', `poptavka--${band}`]} id={id} aria-labelledby={`${id}-nadpis`}>
  <div class="wrap">
    <div class="poptavka-head reveal">
      <h2 id={`${id}-nadpis`}>{nadpis}</h2>
      <p class="lead">{lead}</p>
    </div>

    <PoptavkaForm />
  </div>
</section>

<style>
  .poptavka--kamen {
    background-color: var(--color-kamen);
  }

  .poptavka--omitka {
    background-color: var(--color-omitka);
  }

  /*
   * The one place on the site that is deliberately symmetrical. Everything else
   * is left-of-centre with the right third open (docs/02-design-system.md §3);
   * the form is the destination, so it sits in the middle of the page and the
   * heading sits over the middle of the form.
   */
  .poptavka-head {
    max-width: 42rem;
    margin-inline: auto;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .poptavka-head p {
    margin-inline: auto;
  }

  h2 {
    color: var(--color-mosaz-tmava);
  }

  .lead {
    margin-top: 1rem;
    font-size: var(--text-lead);
  }

  @media (width >= 64rem) {
    .poptavka-head {
      margin-bottom: 3rem;
    }
  }
</style>
