---
/**
 * The property plan.
 *
 * ---------------------------------------------------------------------------
 * `situace2.webp` is the client's aerial with every label painted into the
 * pixels: `Hot Tube`, `Jezírko`, `Mezonetová ložnice 2+3 os.` and a dozen more.
 * docs/01-content.md §9 flags that as launch-blocking, and §4 of the design
 * system asks for the fix in as many words — "Rebuild them as photograph +
 * inline SVG … the map as a whole gets a <title> and a text alternative listing
 * what it shows."
 *
 * The proper rebuild needs a CLEAN AERIAL with no baked type, which the client
 * has not supplied. TODO(client): ask for one. Until it exists, the section is
 * the photograph itself plus `SPOTS` below, which puts every place on the plan
 * into the DOM as real text for a screen reader or a search engine. That list
 * is the reason the painted labels are not the only place this information
 * exists, so it stays even though nothing on screen renders it.
 * ---------------------------------------------------------------------------
 */
import { Image } from 'astro:assets';

import plan from '@img/situace2.webp';

const NBSP = ' ';

interface Spot {
  nazev: string;
  popis: string;
  /** Shown in the text alternative. Capacities, counts, distances. */
  detail?: string;
}

const SPOTS: Spot[] = [
  {
    nazev: 'Potůček',
    popis: 'Teče podél horní hranice pozemku, po celý rok.',
  },
  {
    nazev: 'Jezírko',
    popis: 'Na ochlazení po sauně, hned pod chalupou.',
  },
  {
    nazev: 'Vířivka',
    popis: 'Dřevěný HotTube s vyhřívanými schody, pod širým nebem.',
  },
  {
    nazev: 'Venkovní sauna',
    popis: 'Finská sauna s dřevěnými lavicemi a výhledem do lesa.',
  },
  {
    nazev: 'Krytá terasa',
    popis: 'Venkovní zděný krb a posezení pro celou skupinu, výhled na pastviny.',
  },
  {
    nazev: 'Balkon',
    popis: 'Otevřená terasa s výhledem do zalesněného údolí.',
  },
  {
    nazev: 'Posezení',
    popis: 'Stůl s lavicemi na zahradě, mezi chalupou a jezírkem.',
  },
  {
    nazev: 'Houpačky',
    popis: 'Dřevěná houpačka se dvěma sedátky a skluzavkou.',
  },
  {
    nazev: 'Ohniště',
    popis: 'Na zahradě pod chalupou, stranou od stromů.',
  },
  {
    nazev: 'Parkoviště',
    popis: 'Vlastní příjezdová cesta, parkování přímo u objektu.',
    detail: `4${NBSP}auta`,
  },
  {
    nazev: 'Obývák a kuchyň',
    popis: 'Krb, dlouhý jídelní stůl pod trámovým stropem a okna do zahrady.',
  },
  {
    nazev: 'Ložnice v přízemí',
    popis: 'V přízemí, spolu s koupelnou a WC.',
    detail: `2${NBSP}osoby`,
  },
  {
    nazev: 'Mezonetová ložnice',
    popis: 'V patře, nad terasou.',
    detail: `2${NBSP}+${NBSP}3 osoby`,
  },
  {
    nazev: 'Mezonetová ložnice',
    popis: 'V patře, nad obývacím pokojem. Největší z trojice.',
    detail: `6${NBSP}+${NBSP}2 osoby`,
  },
];
---

<section class="plan section" aria-labelledby="plan-nadpis">
  <div class="wrap">
    <div class="plan-head" data-reveal="up">
      <p class="eyebrow">Areál</p>
      <h2 id="plan-nadpis">Co kde na pozemku najdete</h2>
      <p class="lead">
        Takhle vypadá pozemek shora. Chalupa, vířivka, sauna, jezírko i ohniště.
        Všechno pohromadě, stranou od silnice.
      </p>
    </div>

    <figure class="plan-map" data-reveal="up" data-reveal-delay="90">
      {/*
        ---- WHY IT PANS ON A PHONE ----
        The same problem OkoliMapa.astro solves, and the same fix, because it is
        the same kind of object: an aerial with every label painted into the
        pixels. At 390px edge to edge, `Mezonetová ložnice 2+3 os.` renders at
        about 5px and the section is a green rectangle with a house in it   the
        one graphic that answers "what is actually on the property" told a phone
        reader nothing.

        Below 48rem the figure is a horizontal scroller holding a 40rem minimum,
        so the plate is panned at a size the baked type can be read at. From
        48rem the container is wider than that minimum, there is nothing left to
        scroll, and this is an ordinary block.

        `tabindex="0"` is required rather than decorative: a scroll container
        that cannot take focus cannot be scrolled from a keyboard (WCAG 2.1.1).
        `role="group"` and the label stop a screen reader announcing an unnamed
        scroll region   and the reader already has `SPOTS` below, in text.
      */}
      <div
        class="plan-pan"
        tabindex="0"
        role="group"
        aria-label="Plán pozemku. Na malé obrazovce jej lze posouvat do stran"
      >
        <div class="plan-plate">
      {/*
        `quality` below is 62, not 72. situace2.webp is already a compressed
        WebP, so this is a re-encode — and measured against the source pixels,
        q=72 scored WORSE than q=62 (36.50 dB against 37.13) while costing
        10 kB more, because the extra bits go into faithfully reproducing the
        source's own compression artefacts. 62 is the peak of the curve for
        this file, not a saving taken out of it.
      */}
      <Image
        src={plan}
        alt="Letecký snímek chalupy Heřmanka a jejího pozemku"
        widths={[720, 1000, 1400]}
        sizes="(min-width: 64rem) 64rem, (min-width: 48rem) 100vw, 40rem"
        width={1205}
        height={902}
        format="webp"
        quality={62}
        loading="lazy"
        class="plan-photo"
      />
        </div>
      </div>

      {/*
        An instruction, not a description   the heading and lead above already
        say what this is. `aria-hidden` because the affordance is in the scroll
        region's own label, and it is hidden outright from 48rem where there is
        nothing left to pan.
      */}
      <figcaption class="plan-hint" aria-hidden="true">Plán posuňte prstem do stran.</figcaption>
    </figure>

    {/*
      The text alternative for the map, per docs/02-design-system.md §4. It is
      what a screen reader or a search engine reads instead of squinting at a
      photograph, and it is the reason the painted labels stop being the only
      place this information exists.
    */}
    <div class="sr-only">
      <h3>Seznam míst na pozemku</h3>
      <dl>
        {
          SPOTS.map((s) => (
            <div>
              <dt>{s.nazev}</dt>
              <dd>
                {s.detail ? `${s.detail}. ` : ''}
                {s.popis}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .plan {
    background-color: var(--color-kamen);
  }

  .plan-head {
    max-width: var(--container-prose);
    margin-inline: auto;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  h2 {
    color: var(--color-mosaz-tmava);
  }

  .lead {
    margin-top: 1.25rem;
    font-size: var(--text-lead);
    color: var(--color-kura);
  }

  /* ---- The map ---------------------------------------------------------- */

  .plan-map {
    max-width: 64rem;
    margin: 0 auto;
    line-height: 0;
  }

  /*
   * ⚠ Nothing carrying `data-drift` may ever go inside this. `overflow-x: auto`
   * makes it a scroll container, and `view()` resolves against the nearest
   * ancestor scroll container   a drifting layer in here would take its timeline
   * from a box that scrolls sideways and would sit frozen. Same warning as
   * `.mapa-pan` in OkoliMapa.astro, same reason.
   */
  .plan-pan {
    /* See the identical note on `.okoli-mapa`: a 40rem plate inside a box that
       is allowed to grow to its content takes the whole page sideways with it. */
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    /* Photographs are square-cornered (see the radius note in global.css). */
    background-color: var(--color-les);
  }

  .plan-plate {
    min-width: 40rem;
  }

  @media (width >= 48rem) {
    .plan-plate {
      min-width: 0;
    }
  }

  .plan-photo {
    width: 100%;
    height: auto;
  }

  .plan-hint {
    margin-top: 0.625rem;
    font-size: var(--text-caption);
    line-height: 1.6;
    /* --kura on --kamen = 9.96:1 */
    color: var(--color-kura);
  }

  @media (width >= 48rem) {
    .plan-hint {
      display: none;
    }
  }

  /* On a phone it goes edge to edge, so the panned plate gets the full width. */
  @media (width < 48rem) {
    .plan-map {
      margin-inline: -1.5rem;
    }

    .plan-hint {
      padding-inline: 1.5rem;
    }
  }
</style>
