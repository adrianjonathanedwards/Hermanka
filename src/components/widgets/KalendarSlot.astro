---
/**
 * Availability calendar   the booking rules, the legend, and the live calendar.
 *
 * ---------------------------------------------------------------------------
 * HOW THE CALENDAR ARRIVES
 *
 * The grid is drawn in the browser by src/scripts/availability-calendar.ts from
 * `GET /api/availability`, the Worker in worker/availability/ that reads the
 * e-chalupy iCal feed and caches it in KV. Everything else on this page is real
 * without it:
 *
 *   1. **The two booking rules.** Minimum two nights, and January/February and
 *      July/August are whole weeks only. docs/04-pages.md is explicit that both
 *      "must be visible next to the calendar"   somebody is about to try to book
 *      a weekend in July.
 *   2. **The legend.** The four states of the widget being replaced: Volno ·
 *      Obsazeno · Den příjezdu · Den odjezdu. State is never carried by colour
 *      alone (docs/02-design-system.md §6): every swatch has a pattern too, and
 *      the same patterns are used on the days themselves (src/styles/calendar.css).
 *   3. **The fallback.** `.kalendar-plocha` ships holding the words, the phone
 *      number and the form link. The script replaces them only once the data has
 *      arrived, so a guest is never shown a grid of "free" days that the Worker
 *      has not vouched for. No JavaScript, or a Worker that is down, and this is
 *      what they see   docs/03-tech.md §3 requires exactly that.
 *
 * Choosing a free range fills the inquiry form's Příjezd / Odjezd date inputs; see
 * PoptavkaForm.astro.
 */
import IconLucide from '../IconLucide.astro';
import { SITE } from '../../data/site';
import { PRAVIDLA } from '../../data/cenik';

interface Props {
  /** Anchor id   `/terminy-a-ceny#kalendar` is linked from other pages. */
  id?: string;
}

const { id = 'kalendar' } = Astro.props;

/*
 * The four states of the widget being replaced. `popis` is what each means,
 * because "Den odjezdu" alone does not tell a first-time reader that the day is
 * half free. The half-days are split diagonally: upper left is the morning, lower
 * right the afternoon.
 */
const STAVY = [
  { stav: 'volno', nazev: 'Volno', popis: 'Termín je k dispozici.' },
  { stav: 'obsazeno', nazev: 'Obsazeno', popis: 'Chalupa je obsazená.' },
  { stav: 'prijezd', nazev: 'Den příjezdu', popis: 'Odpoledne se nastěhujete.' },
  { stav: 'odjezd', nazev: 'Den odjezdu', popis: 'Dopoledne se odjíždí.' },
] as const;
---

<section class="section kalendar" id={id} aria-labelledby={`${id}-nadpis`}>
  <div class="wrap">
    <div class="kalendar-head" data-reveal>
      <h2 id={`${id}-nadpis`}>Obsazenost chalupy</h2>
      <p class="lead">
        Než napíšete, mrkněte na dvě pravidla níž{' '}– rozhodují o tom, jestli je váš
        termín vůbec možný.
      </p>
    </div>

    {/*
      The rules come FIRST, above the calendar and not under it. On the old site
      they were a grey line of small print three screens above the grid, and the
      grid is what everybody scrolled to.
    */}
    <ul class="pravidla" data-reveal>
      {
        PRAVIDLA.map((p) => (
          <li class="pravidlo card">
            <IconLucide name={p.icon} size={26} class="pravidlo-icon" />
            <div>
              <h3>{p.nazev}</h3>
              <p>{p.popis}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="kalendar-panel" data-reveal>
      <h3 class="kalendar-legenda-nadpis" id={`${id}-legenda`}>Legenda</h3>
      <ul class="legenda" aria-labelledby={`${id}-legenda`}>
        {
          STAVY.map((s) => (
            <li>
              {/* Decorative: the name beside it says the same in words. */}
              <span class:list={['swatch', `swatch--${s.stav}`]} aria-hidden="true" />
              <span class="legenda-nazev">{s.nazev}</span>
              <span class="legenda-popis">{s.popis}</span>
            </li>
          ))
        }
      </ul>

      {/*
        The mount point. What is inside is the no-JS / Worker-down fallback and is
        replaced wholesale by the script.
      */}
      <div class="kalendar-plocha" data-avail-cal="embedded" role="region" aria-label="Kalendář obsazenosti">
        <div class="kalendar-nahradni">
          <p class="kalendar-nahradni-nadpis">Aktuální obsazenost vám potvrdíme obratem</p>
          <p class="kalendar-nahradni-text">
            Kalendář se teď nepodařilo zobrazit. Napište termín do poptávky nebo zavolejte
            a ozveme se.
          </p>
          <p class="kalendar-nahradni-akce">
            <a href="#poptavka" class="btn btn-primary">Zeptat se na termín</a>
            <a href={`tel:${SITE.telHref}`} class="btn btn-secondary">{SITE.telefon}</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountCalendar } from '../../scripts/availability-calendar';

  const form = document.querySelector<HTMLFormElement>('form[data-poptavka]');
  document
    .querySelectorAll<HTMLElement>('[data-avail-cal="embedded"]')
    .forEach((el) => void mountCalendar(el, form));
</script>

<style>
  .kalendar {
    background-color: var(--color-omitka);
  }

  .kalendar-head {
    max-width: var(--container-prose);
  }

  h2 {
    color: var(--color-mosaz-tmava);
  }

  .lead {
    margin-top: 1rem;
    font-size: var(--text-lead);
  }

  /* ---- The two rules --------------------------------------------------- */

  .pravidla {
    display: grid;
    gap: 1rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .pravidla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .pravidlo {
    flex-direction: row;
    align-items: flex-start;
    gap: 1rem;
  }

  .pravidlo-icon {
    flex: none;
    margin-top: 0.15rem;
    color: var(--color-mosaz-tmava);
  }

  .pravidlo h3 {
    font-size: var(--text-title-s);
  }

  .pravidlo p {
    margin-top: 0.35rem;
    color: var(--color-kura);
  }

  /* ---- The panel the calendar lives in ---------------------------------- */

  /* Tight on a phone on purpose: three nested paddings otherwise leave day cells 33px wide. */
  .kalendar-panel {
    margin-top: 2.5rem;
    padding: 1rem 0.75rem;
    background-color: var(--color-kamen);
    border-radius: var(--radius-sm);
  }

  @media (width >= 40rem) {
    .kalendar-panel {
      padding: 1.5rem;
    }
  }

  @media (width >= 48rem) {
    .kalendar-panel {
      margin-top: 3rem;
      padding: 2rem;
    }
  }

  .kalendar-legenda-nadpis {
    font-size: var(--text-title-s);
    color: var(--color-les);
  }

  .legenda {
    display: grid;
    gap: 0.75rem 1.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .legenda {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .legenda {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .legenda li {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    gap: 0 0.75rem;
    align-items: start;
  }

  /*
   * The swatch is the day cell in miniature: the same fills AND the same patterns
   * as src/styles/calendar.css, because state must never be colour alone. Keep the
   * two in step. Upper left is the morning, lower right the afternoon.
   */
  .swatch {
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid rgb(62 50 38 / 0.25);
    border-radius: var(--radius-sm);
  }

  .swatch--volno {
    background-color: var(--color-omitka);
  }

  .swatch--obsazeno {
    background-color: var(--color-kura);
    background-image: repeating-linear-gradient(
      135deg,
      transparent 0 4px,
      rgb(251 250 248 / 0.2) 4px 6px
    );
  }

  /* Arrival: the morning is still free, the afternoon is taken. */
  .swatch--prijezd {
    background-image: linear-gradient(
      to bottom right,
      var(--color-omitka) 0 50%,
      var(--color-kura) 50% 100%
    );
  }

  /* Departure: the morning is still taken, the afternoon is free. */
  .swatch--odjezd {
    background-image: linear-gradient(
      to bottom right,
      var(--color-kura) 0 50%,
      var(--color-omitka) 50% 100%
    );
  }

  .legenda-nazev {
    font-weight: var(--font-weight-semibold);
  }

  .legenda-popis {
    grid-column: 2;
    font-size: var(--text-caption);
    color: var(--color-kura);
  }

  /* ---- The calendar, or what stands in for it -------------------------- */

  .kalendar-plocha {
    position: relative;
    margin-top: 1.5rem;
    padding: 0.75rem 0.5rem;
    background-color: var(--color-omitka);
    border-radius: var(--radius-sm);
  }

  @media (width >= 40rem) {
    .kalendar-plocha {
      padding: 1.25rem;
    }
  }

  @media (width >= 48rem) {
    .kalendar-plocha {
      padding: 1.75rem 2rem;
    }
  }

  /* Waiting for the Worker: hold the space, say so, and show nothing that could be believed. */
  .kalendar-plocha[aria-busy='true'] {
    min-height: 16rem;
  }

  .kalendar-plocha[aria-busy='true'] .kalendar-nahradni {
    visibility: hidden;
  }

  .kalendar-plocha[aria-busy='true']::after {
    content: 'Načítám obsazenost…';
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    color: var(--color-kura);
  }

  /* Dashed: the one dashed border on the site. It says "the calendar is not here". */
  .kalendar-nahradni {
    padding: 2rem 1.5rem;
    border: 1px dashed rgb(140 99 24 / 0.45);
    border-radius: var(--radius-sm);
    text-align: center;
  }

  .kalendar-nahradni > * {
    margin-inline: auto;
  }

  .kalendar-nahradni-nadpis {
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: var(--text-title-s);
    line-height: 1.3;
    color: var(--color-mosaz-tmava);
  }

  .kalendar-nahradni-text {
    margin-top: 0.75rem;
    max-width: 46ch;
    color: var(--color-kura);
  }

  .kalendar-nahradni-akce {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  @media (width < 25rem) {
    .kalendar-nahradni-akce .btn {
      width: 100%;
    }
  }
</style>
