---
/**
 * Availability calendar   THE RESERVED SLOT, NOT THE CALENDAR.
 *
 * ---------------------------------------------------------------------------
 * ⚠ DO NOT BUILD THE CALENDAR IN HERE.
 *
 * It is deferred by decision. docs/03-tech.md §3 specifies it as a Cloudflare
 * Worker reading an iCal feed and caching it in KV, rendered server-side at build
 * time from the last known good data and refreshed on load   and docs/01-content.md
 * §9 item 15 lists "where availability data will come from" as still unanswered.
 * There is no feed, so there is nothing to render. A hand-built grid of coloured
 * squares filled with invented dates would be worse than no calendar, because it
 * would be believed.
 *
 * WHAT THIS DOES INSTEAD, AND WHY IT IS NOT A "COMING SOON" BOX
 *
 * Everything around the calendar that is real ships now:
 *
 *   1. **The two booking rules.** Minimum two nights, and January/February and
 *      July/August are whole weeks only. docs/04-pages.md is explicit that both
 *      "must be visible next to the calendar"   somebody is about to try to book
 *      a weekend in July. These are the highest-value words on the page and they
 *      do not need a feed.
 *   2. **The legend.** The four states the widget being replaced used, carried
 *      over verbatim: Volno · Obsazeno · Den příjezdu · Den odjezdu. State is
 *      never carried by colour alone (docs/02-design-system.md §6)   each swatch
 *      also has its own glyph, and the glyph is what a colour-blind reader,
 *      Windows high contrast and a black-and-white printout all get.
 *   3. **A way to find out today.** Which is a phone number and the form, which
 *      is what the owner has always actually answered availability with.
 *
 * WHEN THE FEED ARRIVES the grid goes in `.kalendar-plocha`, the legend and the
 * rules stay exactly as they are, and the fallback below becomes the no-JS /
 * feed-down state that docs/03-tech.md §3 already requires ("If the Worker is
 * down, the guest sees build-time availability and the form still works").
 * Nothing else on the page has to change.
 */
import IconLucide from '../IconLucide.astro';
import { SITE } from '../../data/site';
import { PRAVIDLA } from '../../data/cenik';

interface Props {
  /** Anchor id   `/terminy-a-ceny#kalendar` is linked from other pages. */
  id?: string;
}

const { id = 'kalendar' } = Astro.props;

/*
 * The four states of the widget being replaced. `glyph` is the redundant
 * non-colour cue; `popis` is what it means, because "Den odjezdu" alone does not
 * tell a first-time reader that the day is half free.
 */
const STAVY = [
  { stav: 'volno', nazev: 'Volno', glyph: '·', popis: 'Termín je k dispozici.' },
  { stav: 'obsazeno', nazev: 'Obsazeno', glyph: '� ', popis: 'Chalupa je obsazená.' },
  { stav: 'prijezd', nazev: 'Den příjezdu', glyph: '� �', popis: 'Odpoledne se nastěhujete.' },
  { stav: 'odjezd', nazev: 'Den odjezdu', glyph: '� �', popis: 'Dopoledne se odjíždí.' },
] as const;
---

<section class="section kalendar" id={id} aria-labelledby={`${id}-nadpis`}>
  <div class="wrap">
    <div class="kalendar-head" data-reveal>
      <h2 id={`${id}-nadpis`}>Obsazenost chalupy</h2>
      <p class="lead">
        Než napíšete, mrkněte na dvě pravidla níž{' '}– rozhodují o tom, jestli je váš
        termín vůbec možný.
      </p>
    </div>

    {/*
      The rules come FIRST, above the calendar and not under it. On the old site
      they were a grey line of small print three screens above the grid, and the
      grid is what everybody scrolled to.
    */}
    <ul class="pravidla" data-reveal>
      {
        PRAVIDLA.map((p) => (
          <li class="pravidlo card">
            <IconLucide name={p.icon} size={26} class="pravidlo-icon" />
            <div>
              <h3>{p.nazev}</h3>
              <p>{p.popis}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="kalendar-panel" data-reveal>
      <h3 class="kalendar-legenda-nadpis" id={`${id}-legenda`}>Legenda</h3>
      <ul class="legenda" aria-labelledby={`${id}-legenda`}>
        {
          STAVY.map((s) => (
            <li>
              {/*
                The glyph is inside the swatch and `aria-hidden`: it is the
                redundant cue for a sighted reader who cannot use the colour,
                and the name next to it is what everybody else gets.
              */}
              <span class:list={['swatch', `swatch--${s.stav}`]} aria-hidden="true">{s.glyph}</span>
              <span class="legenda-nazev">{s.nazev}</span>
              <span class="legenda-popis">{s.popis}</span>
            </li>
          ))
        }
      </ul>

      {/*
        TODO(feed)   the grid goes here. See the header of this file. It is an
        empty region with an accessible name so that when it is filled the
        landmark and the heading above it are already correct.
      */}
      <div class="kalendar-plocha" role="region" aria-labelledby={`${id}-plocha-nadpis`}>
        <p class="kalendar-plocha-nadpis" id={`${id}-plocha-nadpis`}>
          Kalendář volných termínů připravujeme
        </p>
        <p class="kalendar-plocha-text">
          Zatím vám aktuální obsazenost potvrdíme obratem telefonicky nebo e-mailem.
          Napište termín do poptávky a ozveme se.
        </p>
        <p class="kalendar-plocha-akce">
          <a href="#poptavka" class="btn btn-primary">Zeptat se na termín</a>
          <a href={`tel:${SITE.telHref}`} class="btn btn-secondary">{SITE.telefon}</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .kalendar {
    background-color: var(--color-omitka);
  }

  .kalendar-head {
    max-width: var(--container-prose);
  }

  h2 {
    color: var(--color-mosaz-tmava);
  }

  .lead {
    margin-top: 1rem;
    font-size: var(--text-lead);
  }

  /* ---- The two rules --------------------------------------------------- */

  .pravidla {
    display: grid;
    gap: 1rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .pravidla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .pravidlo {
    flex-direction: row;
    align-items: flex-start;
    gap: 1rem;
    /* The rules are the point of the section, so they get the brass edge. */
    border-left: 3px solid var(--color-mosaz);
  }

  .pravidlo-icon {
    flex: none;
    margin-top: 0.15rem;
    color: var(--color-mosaz-tmava);
  }

  .pravidlo h3 {
    font-size: var(--text-title-s);
  }

  .pravidlo p {
    margin-top: 0.35rem;
    color: var(--color-kura);
  }

  /* ---- The panel the calendar will live in ------------------------------ */

  .kalendar-panel {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background-color: var(--color-kamen);
    border-radius: var(--radius-sm);
  }

  @media (width >= 48rem) {
    .kalendar-panel {
      margin-top: 3rem;
      padding: 2rem;
    }
  }

  .kalendar-legenda-nadpis {
    font-size: var(--text-title-s);
    color: var(--color-les);
  }

  .legenda {
    display: grid;
    gap: 0.75rem 1.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .legenda {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 64rem) {
    .legenda {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .legenda li {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    gap: 0 0.75rem;
    align-items: start;
  }

  /*
   * The swatch carries BOTH the colour and a glyph. docs/02-design-system.md §6:
   * calendar state must never be conveyed by colour alone.
   */
  .swatch {
    display: grid;
    place-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid rgb(62 50 38 / 0.25);
    border-radius: var(--radius-sm);
    font-size: var(--text-caption);
    line-height: 1;
    color: var(--color-les);
  }

  /*
   * Not the old widget's green and pink. `--omitka` for free and `--kura` for
   * taken is the site's own light/dark pair, and the two half-days are the same
   * two colours split   which is literally what the day is.
   */
  .swatch--volno {
    background-color: var(--color-omitka);
  }

  .swatch--obsazeno {
    background-color: var(--color-kura);
    color: var(--color-omitka);
  }

  .swatch--prijezd {
    background-image: linear-gradient(
      to bottom right,
      var(--color-kura) 0 50%,
      var(--color-omitka) 50% 100%
    );
  }

  .swatch--odjezd {
    background-image: linear-gradient(
      to bottom right,
      var(--color-omitka) 0 50%,
      var(--color-kura) 50% 100%
    );
  }

  .legenda-nazev {
    font-weight: var(--font-weight-semibold);
  }

  .legenda-popis {
    grid-column: 2;
    font-size: var(--text-caption);
    color: var(--color-kura);
  }

  /* ---- The reserved area ------------------------------------------------ */

  .kalendar-plocha {
    margin-top: 1.5rem;
    padding: 2rem 1.5rem;
    background-color: var(--color-omitka);
    /* Dashed, and the only dashed border on the site: it says "a thing goes
       here" without pretending a thing is already here. */
    border: 1px dashed rgb(140 99 24 / 0.45);
    border-radius: var(--radius-sm);
    text-align: center;
  }

  .kalendar-plocha > * {
    margin-inline: auto;
  }

  .kalendar-plocha-nadpis {
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: var(--text-title-s);
    line-height: 1.3;
    color: var(--color-mosaz-tmava);
  }

  .kalendar-plocha-text {
    margin-top: 0.75rem;
    max-width: 46ch;
    color: var(--color-kura);
  }

  .kalendar-plocha-akce {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  @media (width < 25rem) {
    .kalendar-plocha-akce .btn {
      width: 100%;
    }
  }
</style>
