---
/**
 * Subpage header   the band every page except `/` opens with.
 *
 * The old site put a fixed 300px photograph strip behind a centred serif title on
 * `/o-nas/`, `/ubytovani/`, `/volne-terminy-a-ceny/`, `/tipy-na-vylety/` and
 * `/kontakt/`   the same crop of the same exterior five times. The photograph is
 * kept, because a page about a cottage should open on the cottage; the centring
 * is not. docs/02-design-system.md §3 sets this site left of centre with the
 * right third open, and the two sanctioned exceptions (the O nás clearing and the
 * inquiry form) are both moments where the page addresses the reader directly. A
 * page title is not one of them.
 *
 * ⚠ THIS IS THE LCP ELEMENT ON EVERY PAGE THAT USES IT.
 *
 * The image props live in `src/data/pageHero.ts` and are spread into BOTH the
 * <Image> below and the `getImage()` call each page makes to feed
 * `heroPreload` on BaseLayout. They must describe exactly the same transform or
 * the browser preloads one file and renders another   the hero downloaded twice,
 * which is the worst possible outcome for the one image being made fast. Never
 * retype them; import them.
 *
 * A page may pass its own photograph. `alt` then becomes required in practice  
 * the default alt describes the default exterior and nothing else.
 *
 * NO ENTRANCE ANIMATION on the photograph (docs/02-design-system.md §5.3). The
 * copy fades in with a plain keyframe rather than through `data-reveal`, for the
 * reason Hero.astro gives: `data-reveal` hides its target until
 * IntersectionObserver has booted, which would put a JavaScript round trip in
 * front of the first thing anyone sees on the page.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import { PAGE_HERO_IMAGE, PAGE_HERO_ALT, PAGE_HERO_IMAGE_PROPS } from '../data/pageHero';

interface Props {
  /** The page's <h1>. One per page, and this is it. */
  title: string;
  /** Optional single sentence under the title. Keep it under about 90 characters. */
  lead?: string;
  /** Override the default exterior. Pass `alt` with it. */
  image?: ImageMetadata;
  /** Czech alt. Describes the photograph, not the page. */
  alt?: string;
  /** `object-position` for the crop. A portrait viewport keeps about a quarter of the width. */
  position?: string;
}

const {
  title,
  lead,
  image = PAGE_HERO_IMAGE,
  alt = PAGE_HERO_ALT,
  position = '55% center',
} = Astro.props;
---

<section class="page-hero">
  <div class="page-hero-media">
    <Image src={image} alt={alt} style={`object-position: ${position}`} {...PAGE_HERO_IMAGE_PROPS} />
  </div>

  {/*
    Two gradients, not a flat wash. The band across the top is what keeps the
    fixed header's --omitka labels readable where they sit over a pale roof; the
    floor is what holds the title above 4.5:1. Measured against this photograph
    at its lightest: --omitka over --les at 0.72 gives 11.1:1.
  */}
  <div class="page-hero-scrim" aria-hidden="true"></div>

  <div class="wrap page-hero-inner">
    <h1>{title}</h1>
    {lead && <p class="page-hero-lead">{lead}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: grid;
    align-content: end;
    /*
     * Deliberately not a full viewport. This band is a title with a photograph
     * behind it, not a hero   the page's actual first section has to be visible
     * under it on a laptop, or every subpage opens on a picture the reader has
     * already seen on the homepage.
     */
    min-height: min(52svh, 26rem);
    /* The top clears the fixed header: 4.5rem mobile, 5.5rem from 64rem up. */
    padding-block: 7.5rem 2.5rem;
    overflow: hidden;
    background-color: var(--color-les);
    color: var(--color-omitka);
    isolation: isolate;
  }

  @media (width >= 64rem) {
    .page-hero {
      min-height: min(56svh, 32rem);
      padding-block: 10rem 3.5rem;
    }
  }

  .page-hero-media,
  .page-hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .page-hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero-scrim {
    background-image:
      linear-gradient(to bottom, rgb(22 36 28 / 0.72) 0%, rgb(22 36 28 / 0.1) 32%),
      linear-gradient(to top, rgb(22 36 28 / 0.82) 0%, rgb(22 36 28 / 0.25) 55%, transparent 100%);
  }

  .page-hero-inner {
    position: relative;
  }

  h1 {
    max-width: 18ch;
    /* --omitka over the scrimmed photograph. Never brass: --mosaz on --les is
       3.00:1 and fails (docs/02-design-system.md §1.2). */
    color: var(--color-omitka);
    text-shadow: 0 1px 24px rgb(22 36 28 / 0.5);
  }

  .page-hero-lead {
    margin-top: 1rem;
    max-width: 44ch;
    font-size: var(--text-lead);
    /* Stone, not frost: --jinovatka is a winter accent only (§1). */
    color: var(--color-kamen);
    text-shadow: 0 1px 20px rgb(22 36 28 / 0.55);
  }

  /*
   * Plain keyframes on the copy alone. The photograph never moves   it is the
   * LCP element and animating it delays the one thing the guest came for.
   */
  @media (prefers-reduced-motion: no-preference) {
    h1,
    .page-hero-lead {
      animation-name: page-hero-in;
      animation-duration: 620ms;
      animation-timing-function: var(--ease-emphasized);
      animation-fill-mode: both;
    }

    .page-hero-lead {
      animation-delay: 90ms;
    }
  }

  @keyframes page-hero-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
</style>
