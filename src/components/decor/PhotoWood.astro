---
/**
 * A stand of spruce standing in front of a photograph.
 *
 * The job is the oldest device in landscape drawing: put trees across the near
 * edge of the frame and the viewer is standing *in* the wood looking out, rather
 * than looking at a picture. On the Dolní Morava band that is the point — the
 * resort is somewhere you look across at from the wood the cottage sits in, and
 * that relationship is what "12 minutes away" is actually about.
 *
 * ---------------------------------------------------------------------------
 * WHY THIS AND NOT A BOUGH ACROSS THE CORNER
 * The first attempt was a branch reaching in from each corner, generated stem
 * and needles. Two versions of it failed the same way: drawn as strokes it was a
 * fishbone — the exact failure §4 rule 2 names — and drawn as a filled outline
 * it was a saw blade. A spruce bough is a hard thing to generate and an easy
 * thing to get wrong, and the site already owns a drawing of spruce that works.
 *
 * So this is the treeline device, reused. Same generator, same notched crowns,
 * two ranks. The only new idea is the ENVELOPE: `saddle` gives full-height trees
 * at both edges dropping to a low band across the middle, which was written for
 * the footer wood so the inquiry form could sit in clear air. Here it does the
 * same job for the pistes — the subject of the photograph stays in the open,
 * and the trees close in at the sides where nothing is happening.
 * ---------------------------------------------------------------------------
 *
 * Filled silhouette in --les, layered at two opacities for depth, per the
 * recorded treeline exception in §4 rule 3: these are masses the view is seen
 * through, not ornament laid over a photograph. The white-line rule still
 * governs anything that is genuinely ornament.
 */
import { plantRank, transformFor } from './forest';

interface Props {
  class?: string;
}

/*
 * `rest` is load-bearing. Astro hands a child the PARENT's `data-astro-cid-…`
 * as a prop and expects it on the child's root element; without the spread,
 * every scoped rule the caller writes against this component matches nothing
 * and the SVG lays itself out in normal flow. See Icon.astro.
 */
const { class: className, ...rest } = Astro.props;

/*
 * Six crowns, tip at y=-112 and closed on the ground line at y=0. CROWN ONLY,
 * no trunk — see Treeline.astro for why: a wood seen from outside is a mass of
 * foliage, and the gap a trunk implies is what makes a rank read as a row of
 * separate ornaments. Drawn to §4: a narrow spike leader over three to five
 * boldly notched tiers, every flank different from its opposite.
 */
const SPRUCES = [
  `M0 -112 L5 -88 L2 -93 L14 -58 L6 -64 L24 -24 L9 -31 L30 0 L-28 0 L-8.5 -30 L-22 -25 L-5.5 -63 L-13 -57 L-2 -92 L-4.5 -87 Z`,
  `M0 -112 L6 -80 L2.5 -86 L17 -50 L7 -57 L27 -18 L10 -26 L32 0 L-30 0 L-9 -27 L-25 -19 L-6.5 -55 L-15 -48 L-2.5 -85 L-5 -79 Z`,
  `M0 -112 L4.5 -94 L1.5 -98 L11 -70 L5 -75 L19 -44 L8 -50 L27 -20 L10 -27 L31 0 L-29 0 L-9.5 -28 L-25 -21 L-7 -49 L-17.5 -43 L-4.5 -74 L-10 -69 L-1.5 -97 L-4 -93 Z`,
  `M0 -112 L7 -84 L2 -90 L18 -52 L6 -60 L28 -20 L9 -28 L33 0 L-27 0 L-8 -29 L-23 -22 L-5.5 -58 L-14 -51 L-2 -89 L-5.5 -83 Z`,
  `M0 -112 L4 -90 L1.5 -95 L10 -62 L4.5 -68 L17 -30 L7 -37 L22 0 L-20 0 L-6.5 -38 L-15.5 -32 L-4 -67 L-9 -61 L-1.5 -94 L-3.5 -89 Z`,
  `M1 -112 L8 -76 L2.5 -83 L20 -46 L7 -54 L30 -16 L10 -25 L35 0 L-32 0 L-10 -26 L-26 -17 L-7 -52 L-17 -44 L-2.5 -81 L-6 -74 Z`,
];

/*
 * ⚠ The viewBox ASPECT is the load-bearing number here, not the size.
 *
 * `preserveAspectRatio` is `slice`, so the SVG scales to COVER its box and crops
 * whichever axis is proportionally longer. A wide viewBox in a nearly-square
 * panel gets cropped hard at the sides — and the sides are exactly where the
 * saddle puts the full-height trees, so the composition this component exists
 * for was being thrown away and only the low middle survived.
 *
 * 900 × 700 is 1.29:1, against roughly 1.23:1 for the panel on a laptop and
 * 1.11:1 on a phone. Both crop by under 5 % a side, so the edge stand is kept.
 */
const W = 900;
const H = 700;
const BASE_Y = 692;

/*
 * Two ranks, back to front. Scales are chosen so the edge trees stand about two
 * thirds of the frame — tall enough to be trees you are standing among, short
 * enough that the ridge and the Sky Walk at the top of the photograph are still
 * in open sky.
 *
 * `saddle` is the whole composition. 0.17 means the middle of the rank drops to
 * 17 % of full height: a low band of wood along the bottom edge, with the stand
 * closing in at both sides. Scales never go below 0.45 of the drawn size — under
 * that the notches close up and the crown reverts to the plain triangle the
 * shape exists to avoid.
 */
const RANKS = [
  { opacity: 0.45, seed: 6720114, gap: [58, 150] as [number, number], scale: [2.9, 4.2] as [number, number], saddle: 0.13, giants: 0.14 },
  { opacity: 1, seed: 3391807, gap: [48, 124] as [number, number], scale: [2.4, 3.5] as [number, number], saddle: 0.16, giants: 0.1 },
];

const PLANTED = RANKS.map((r) => ({
  opacity: r.opacity,
  trees: plantRank({
    seed: r.seed,
    width: W,
    shapes: SPRUCES.length,
    gap: r.gap,
    scale: r.scale,
    saddle: r.saddle,
    giants: r.giants,
    wobble: 5,
  }),
}));
---

{/*
  `slice`, never `none`: a non-uniform fit would squash the crowns and the
  notches would stop reading as notches. Bottom-aligned, so however the panel is
  proportioned the trees always stand on its lower edge and the crop happens at
  the sides — where one stretch of wood looks like any other.
*/}
<svg
  class={className}
  {...rest}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    {SPRUCES.map((d, i) => <path id={`pw-s${i}`} d={d} />)}
  </defs>

  {
    PLANTED.map((rank, i) => (
      <g fill="var(--color-les)" opacity={rank.opacity}>
        {rank.trees.map((t) => <use href={`#pw-s${t.shape}`} transform={transformFor(t, BASE_Y)} />)}
        {/* Solid foot on the front rank only, so no strip of photograph shows
            under the trunks and the wood meets the frame edge cleanly. */}
        {i === PLANTED.length - 1 && <rect x="0" y={BASE_Y - 4} width={W} height="14" />}
      </g>
    ))
  }
</svg>
