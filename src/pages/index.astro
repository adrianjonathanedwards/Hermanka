---
/**
 * Homepage.
 *
 * Structure, content and semantics pass. Decoration   the hand-drawn illustration
 * language, section reveals, the map line work as inline SVG   comes next.
 *
 * Section order is docs/04-pages.md. Every section either moves the reader toward
 * the inquiry form with dates in hand, or answers the objection in the way of it.
 */
import { getImage } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Fakta from '../components/sections/Fakta.astro';
import ONas from '../components/sections/ONas.astro';
import Okoli from '../components/sections/Okoli.astro';
import Ubytovani from '../components/sections/Ubytovani.astro';
import PlanArealu from '../components/sections/PlanArealu.astro';
import Wellness from '../components/sections/Wellness.astro';
import GalerieTeaser from '../components/sections/GalerieTeaser.astro';
import DolniMorava from '../components/sections/DolniMorava.astro';
import CenaBand from '../components/sections/CenaBand.astro';
import Poptavka from '../components/sections/Poptavka.astro';
import RoofDivider from '../components/decor/RoofDivider.astro';

import { HERO_PRELOAD_PROPS, HERO_SIZES } from '../data/hero';

/*
 * Resolve the FIRST slide's transform here so <head> can preload precisely the
 * variant the hero will render. Identical props object, so identical output  
 * Astro dedupes the transform and this costs nothing extra in the build.
 *
 * ⚠ Slide one only. The hero is a carousel now, and preloading the other four
 * would put four full-bleed photographs on the critical path in front of the LCP
 *   see the warning at the top of src/data/hero.ts.
 */
const hero = await getImage(HERO_PRELOAD_PROPS);
---

<BaseLayout
  title="Chalupa pro 15 lidí pod Králickým Sněžníkem"
  description="Chalupa Heřmanka v Heřmanicích u Králík. Celá chalupa pro 2 až 15 osob ve 3 ložnicích. Venkovní sauna, vířivka, jezírko a les hned za dveřmi. Dolní Morava 12 minut autem."
  heroPreload={{ src: hero.src, srcset: hero.srcSet.attribute, sizes: HERO_SIZES }}
>
  <Hero />
  <Fakta />
  <ONas />
  <Okoli />
  <Ubytovani />
  <PlanArealu />
  <Wellness />
  <RoofDivider />
  <GalerieTeaser />
  <DolniMorava />
  <RoofDivider />
  <CenaBand />
  <Poptavka />
</BaseLayout>
