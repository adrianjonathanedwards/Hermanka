---
/**
 * /galerie — Galerie
 *
 * Eight photographs grouped by subject. Every tile is a real <a> link so that
 * without JavaScript a click opens the full-size image directly in the browser
 * (href = the large-variant URL). With JavaScript, motion.ts intercepts the
 * click, calls e.preventDefault(), and opens the native <dialog> instead.
 *
 * The <dialog> itself (Lightbox.astro) is rendered by BaseLayout on every page;
 * do not add it here and do not write any JavaScript.
 *
 * ── Portrait / landscape mix ──────────────────────────────────────────────────
 * DSC_5123 (jídelna) and DSC_5204 (sauna) are portrait-oriented images. The
 * rest are landscape. Detected at build time from the imported ImageMetadata
 * (f.src.height > f.src.width) rather than a hardcoded flag, so the detection
 * stays correct if a replacement photograph lands in the same slot.
 *
 * In each group that mixes orientations the portrait tile holds its natural
 * 3:4 aspect ratio; the landscape tile beside it stretches to match the
 * portrait's height via `height: 100%` inside a grid row whose height the
 * portrait sets. No cropping on the portrait; the landscape is cropped at
 * top/bottom, which is the least harmful crop for these specific images.
 * On mobile (single column) every tile shows its own natural aspect ratio and
 * nothing is cropped at all.
 *
 * ── No-JS fallback ───────────────────────────────────────────────────────────
 * href={foto.velka.src} — a click with scripting off opens the large-variant
 * WebP directly. The large variant is the logical fallback here: we are already
 * on /galerie, there is no other page to navigate to.
 *
 * ── Lightbox wiring ──────────────────────────────────────────────────────────
 * motion.ts collects all [data-lightbox] anchors in DOM order and navigates
 * among them with prev/next. Tile order here: exterier → terasa → obyvak →
 * jídelna → sauna → vířivka → houpačky → okolí.
 *
 * TODO(client) — docs/01-content.md §10: this gallery is eight photographs
 * because eight photographs is the whole asset set for this property. What is
 * missing: bedroom photographs, a winter exterior, an interior with the fire
 * lit, and photography with people in it. „The audience is a group of twelve;
 * show a table with twelve people at it."
 */
import { getImage, Image } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Icon from '../components/Icon.astro';

import { FOTKY, SKUPINY } from '../data/galerie';
import { PAGE_HERO_PRELOAD_PROPS, PAGE_HERO_SIZES } from '../data/pageHero';

/** Czech non-breaking space — prepositions, numerals, units. §2.6 */
const NBSP = ' ';

// Resolve the page hero preload — same transform as PageHero.astro uses, so
// the browser preloads exactly the file the component will render.
const hero = await getImage(PAGE_HERO_PRELOAD_PROPS);

/*
 * Large lightbox variants. Generated at build time and stored on disk.
 * Nothing requests them until a tile is opened, so they cost zero bytes on
 * load. Pattern mirrors GalerieTeaser.astro exactly.
 */
const velke = await Promise.all(
  FOTKY.map((f) => getImage({ src: f.src, width: 1600, format: 'webp', quality: 72 })),
);

// Augment each FOTKY entry with build-time derived fields.
const fotkyAug = FOTKY.map((f, i) => ({
  ...f,
  /** The large-variant object produced by getImage(). */
  velka: velke[i],
  /**
   * The photograph's own aspect ratio, width ÷ height. It is handed to CSS as
   * `--ar` on the tile and is what makes the justified row below work: a tile's
   * `flex-grow` is its aspect ratio, so every tile in a row ends up the same
   * height with its own true proportions. See the grid comment in <style>.
   */
  ar: f.src.width / f.src.height,
  /**
   * The chalupa group (photos 0–1) is near the top of the page; load eagerly
   * so they are not lazy-loaded during the short intro scroll.
   */
  isEager: i < 2,
}));

// Pair SKUPINY with their augmented photos.
const skupinyAug = SKUPINY.map((s) => ({
  ...s,
  fotos: fotkyAug.filter((f) => f.skupina === s.klic),
}));

/*
 * Band alternation — every adjacent pair must be a different colour.
 *
 * PageHero:  --les   (dark, from PageHero.astro)
 * Group 0:   --omitka  ← intro paragraph also lives here
 * Group 1:   --kamen
 * Group 2:   --omitka
 * Group 3:   --kamen
 * CtaBand:   --omitka  (last section is light; treeline rises out of it)
 */
const skupinaBand = (i: number): 'omitka' | 'kamen' =>
  i % 2 === 0 ? 'omitka' : 'kamen';
---

<BaseLayout
  title="Galerie"
  description={`Fotografie chalupy Heřmanka: exteriér, obývák s${NBSP}krbem, sauna, vířivka a${NBSP}zahrada v${NBSP}lesích u${NBSP}Dolní Moravy.`}
  heroPreload={{ src: hero.src, srcset: hero.srcSet.attribute, sizes: PAGE_HERO_SIZES }}
>
  <PageHero
    title="Galerie"
    lead="Jak chalupa vypadá uvnitř i venku."
  />

  {skupinyAug.map((skupina, si) => {
    const band = skupinaBand(si);

    return (
      <section
        class:list={['section', 'galerie-skupina', `galerie-skupina--${band}`]}
        aria-labelledby={`skupina-${skupina.klic}`}
      >
        <div class="wrap" data-reveal>

          {/*
            The intro line sits inside the first group's section (--omitka) so
            it flows naturally between the dark hero and the first grid rather
            than creating a third adjacent light band.
          */}
          {si === 0 && (
            <p class="galerie-uvod">
              Osm fotografií — všechny, které máme. Kliknutím se snímek otevře v{NBSP}plné
              velikosti.
            </p>
          )}

          <h2 class="galerie-skupina-nadpis" id={`skupina-${skupina.klic}`}>
            {skupina.nazev}
          </h2>

          <ul class="galerie-grid" role="list">
            {skupina.fotos.map((foto) => (
              <li class="galerie-tile" style={`--ar: ${foto.ar}`}>
                {/*
                  Real link first. href = large-variant URL so a JavaScript-off
                  click opens the photograph. data-lightbox upgrades this to the
                  <dialog> when JS is available (motion.ts).

                  aria-label is read by screen readers in place of the link
                  text; the embedded <img> alt is read by the lightbox when the
                  dialog opens. They describe the same thing so the user hears
                  it once, not twice, in each context.
                */}
                <a
                  href={foto.velka.src}
                  class="galerie-item photo-frame"
                  data-lightbox={foto.velka.src}
                  aria-label={`Zvětšit fotografii: ${foto.alt}`}
                >
                  {/*
                    `width`/`height` are the photograph's OWN dimensions, not a
                    normalised 900×600 / 600×800 pair. The tile is now sized from
                    the same ratio (`--ar`), so declaring anything else here would
                    reserve a box of one shape and paint a picture of another —
                    which is a layout shift on exactly the page made of pictures.

                    `sizes` is deliberately loose. A justified row gives a wide
                    photograph more width than a tall one, so no single number is
                    right for both; 45vw is the widest a tile gets in a two-up row
                    at 1280 and it is the safe way to be wrong.
                  */}
                  <Image
                    src={foto.src}
                    alt={foto.alt}
                    widths={[360, 480, 600, 900]}
                    sizes="(min-width: 48rem) 45vw, 100vw"
                    width={foto.src.width}
                    height={foto.src.height}
                    format="webp"
                    quality={65}
                    loading={foto.isEager ? 'eager' : 'lazy'}
                  />
                  {/* Hover / focus overlay — decorative affordance only */}
                  <span class="galerie-overlay" aria-hidden="true">
                    <span class="galerie-expand">
                      <Icon name="zvetsit" size={20} strokeWidth={1.6} />
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    );
  })}

  {/*
    Band above CtaBand is Group 3 (--kamen), so CtaBand takes --omitka.
    Last section must be light — the treeline silhouette rises out of it.
  */}
  <CtaBand
    nadpis="Zaujala vás chalupa?"
    text={`Napište nám termín a${NBSP}počet osob. Ozveme se co nejdříve s${NBSP}dostupností a${NBSP}cenou.`}
    href="/terminy-a-ceny"
    cta="Zkontrolovat termíny"
    band="omitka"
  />
</BaseLayout>

<style>
  /* ── Group sections ────────────────────────────────────────────────────── */

  .galerie-skupina--omitka {
    background-color: var(--color-omitka);
  }

  .galerie-skupina--kamen {
    background-color: var(--color-kamen);
  }

  /* ── Intro paragraph ────────────────────────────────────────────────────
   *
   * One honest sentence about the asset set size. Lives before the first
   * group heading so it reads as a section-level note, not a caption.
   */
  .galerie-uvod {
    font-size: var(--text-lead);
    color: var(--color-kura);
    margin-bottom: 2.5rem;
    max-width: var(--container-prose);
  }

  /* ── Group heading ──────────────────────────────────────────────────────
   *
   * --mosaz-tmava: 6.05:1 on --omitka, 5.06:1 on --kamen (§1.2). Plain
   * --mosaz as text fails on --kamen (4.30:1) and must not be used here.
   */
  .galerie-skupina-nadpis {
    color: var(--color-mosaz-tmava);
    margin-bottom: 1.5rem;
  }

  @media (width >= 48rem) {
    .galerie-skupina-nadpis {
      margin-bottom: 2rem;
    }
  }

  /* ── Grid ────────────────────────────────────────────────────────────────
   *
   * Single column on mobile — every tile shows its own natural aspect ratio
   * so nothing is cropped on the smallest viewports.
   * Two columns from 48rem; the portrait/landscape handling below takes over.
   */
  /* ── The justified row ──────────────────────────────────────────────────
   *
   * ⚠ THIS WAS A TWO-COLUMN GRID AND IT CROPPED THE PHOTOGRAPHS BADLY.
   *
   * Two of the eight photographs are portrait (the dining table and the sauna)
   * and the rest are landscape, and each group happens to pair one of each. In
   * an equal-column grid the portrait tile is far taller than the landscape one,
   * the row stretches to the portrait's height, and the landscape photograph
   * gets `object-fit: cover`-ed into a box half again as tall as it is. On the
   * page that meant the living room reduced to a picture of its floorboards and
   * the hot tub hidden behind a blurred leaf — on the one page whose entire job
   * is showing the photographs properly.
   *
   * The fix is the classic justified row, and it crops nothing at all.
   *
   * Every tile carries its own aspect ratio as `--ar` (width ÷ height, set
   * inline from the file's real dimensions). In a flex row with `flex-basis: 0`,
   * giving each tile `flex-grow: var(--ar)` divides the available width in
   * proportion to the ratios — which is exactly the width each photograph needs
   * to reach one common height. Wide pictures get more room, tall pictures get
   * less, every picture is whole, and the row has a flat top and a flat bottom.
   *
   * `aspect-ratio: var(--ar)` on the item is what sets that height, and it is
   * also the box the browser reserves before the bytes arrive.
   *
   * Below 48rem it is one photograph per line at its own ratio — a justified row
   * of two on a 360px screen would make each of them 170px wide.
   */
  .galerie-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (width >= 48rem) {
    .galerie-grid {
      flex-direction: row;
      align-items: flex-start;
    }

    .galerie-tile {
      /* grow ∝ aspect ratio, shrink allowed, basis 0 — see the note above. */
      flex: var(--ar) 1 0;
      min-width: 0;
    }
  }

  /* ── Item (the link/frame) ─────────────────────────────────────────────
   *
   * Square corners — a rounded photo is a web page decorating itself
   * (docs/02-design-system.md §3). .photo-frame from global.css supplies the
   * 1.02 scale hover on pointer devices.
   */
  .galerie-item {
    position: relative;
    display: block;
    width: 100%;
    /* The photograph's own ratio. Nothing is normalised and nothing is cropped. */
    aspect-ratio: var(--ar);
    overflow: hidden;
    background-color: var(--color-kamen);
  }

  /*
   * `cover` rather than `contain`, and it does no cropping: the box is already
   * the picture's own ratio, so the two are identical here. It is `cover` so
   * that a rounding error at some viewport shows as a lost hairline rather than
   * as a stone letterbox down one edge.
   */
  .galerie-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Hover / focus overlay ──────────────────────────────────────────────
   *
   * An expand icon behind a translucent scrim. Shows on hover and on
   * keyboard focus-visible so the affordance is reachable without a pointer.
   * opacity: 0 in the base rule is fine here — it is decoration that sits on
   * top of already-visible content, not an element whose disappearance hides
   * the content.
   */
  .galerie-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(to top, rgb(22 36 28 / 0.55), rgb(22 36 28 / 0.15));
    opacity: 0;
    transition: opacity 320ms var(--ease-out);
  }

  .galerie-expand {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid rgb(251 250 248 / 0.7);
    border-radius: var(--radius-pill);
    color: var(--color-omitka);
    transform: scale(0.75);
    transition: transform 380ms var(--ease-spring);
  }

  /*
   * :focus-visible, not :focus — only show the overlay on keyboard navigation,
   * not on mouse click (which immediately opens the lightbox anyway).
   */
  .galerie-item:hover .galerie-overlay,
  .galerie-item:focus-visible .galerie-overlay {
    opacity: 1;
  }

  .galerie-item:hover .galerie-expand,
  .galerie-item:focus-visible .galerie-expand {
    transform: scale(1);
  }
</style>
