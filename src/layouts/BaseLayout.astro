---
/**
 * The only layout. Every page wraps in this.
 *
 * It owns <head>, the site header and the site footer   the three landmarks every
 * page shares. Page content goes in the <main> slot.
 */
import { getLocaleFromUrl, localePath, stripLocale } from '../i18n/utils';
import { useTranslations } from '../i18n/ui';
import { HTML_LANG, LIVE_LOCALES } from '../i18n/config';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Lightbox from '../components/Lightbox.astro';
import '../styles/global.css';

interface Props {
  /** Page title, without the site name   that is appended here. */
  title: string;
  /** Meta description. Czech. Aim for 140–160 characters. */
  description: string;
  /**
   * The hero image, if this page has one. Preloaded at high priority; it is the
   * only image on the page that may be. Everything else is lazy
   * (docs/03-tech.md §Images).
   *
   * `srcset`/`sizes` must match the <Image> in the hero component exactly, or the
   * browser preloads a variant the page never uses and downloads the hero twice.
   */
  heroPreload?: { src: string; srcset?: string; sizes?: string };
  /**
   * Social share image. Absolute or site-root path.
   *
   * `/og-default.jpg` is a 1200x630 crop of the hero photograph, generated into
   * public/ (it is a fixed asset, not an astro:assets import   a share card has
   * to live at a stable URL that a scraper can fetch without parsing HTML).
   *
   * JPEG on purpose. Facebook, X, LinkedIn, Slack and Discord all read WebP now;
   * WhatsApp still does not reliably, and a share card that silently fails on the
   * one channel a Czech guest is most likely to use is not worth the 40 kB.
   */
  ogImage?: string;
  /** Set true on pages that must not be indexed. */
  noindex?: boolean;
  /**
   * Start the site header solid instead of transparent.
   *
   * ⚠ Required on any page whose FIRST SCREEN IS LIGHT. The header is white type
   * on nothing until the hero scrolls away; over `--omitka` it is invisible. See
   * the `solid` prop on SiteHeader.astro. Pages with a photographic hero   the
   * homepage and everything using PageHero   leave this alone.
   */
  headerSolid?: boolean;
}

const {
  title,
  description,
  heroPreload,
  ogImage = '/og-default.jpg',
  noindex = false,
  headerSolid = false,
} = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const siteName = t('site.name');
/* Pipe, not a dash. No em dash appears in any text this site renders. */
const fullTitle = title ? `${title} | ${siteName}` : siteName;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const pathWithoutLocale = stripLocale(Astro.url.pathname);

/*
 * Sitewide WebSite entity, on every page   otherwise the only structured data
 * on the whole site lives on one page (ubytovani.astro's LodgingBusiness) and
 * nothing ties the two together into one graph. `publisher` references that
 * LodgingBusiness by its existing `@id` (its canonical URL) rather than
 * redeclaring it here, so there is exactly one definition of the business to
 * keep in sync.
 */
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).href,
  url: new URL('/', Astro.site).href,
  name: siteName,
  inLanguage: HTML_LANG[locale],
  publisher: { '@id': new URL('/ubytovani', Astro.site).href },
};
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Fonts are preloaded before anything else in <head> so the request starts on
      the first byte of HTML. Two files, 40.7 kB together, both subset to a Czech
      charset   see docs/02-design-system.md §2.3.
      `crossorigin` is required on font preloads even for same-origin, or the
      browser fetches the file twice.
    */}
    <link
      rel="preload"
      href="/fonts/fraunces-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/public-sans-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* The hero is the LCP element and the only image that gets this treatment. */}
    {
      heroPreload && (
        <link
          rel="preload"
          as="image"
          href={heroPreload.src}
          imagesrcset={heroPreload.srcset}
          imagesizes={heroPreload.sizes}
          fetchpriority="high"
        />
      )
    }

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/*
      hreflang is emitted only for locales that actually have content
      (src/i18n/config.ts LIVE_LOCALES). Today that is Czech alone.
    */}
    {
      LIVE_LOCALES.length > 1 &&
        LIVE_LOCALES.map((loc) => (
          <link
            rel="alternate"
            hreflang={HTML_LANG[loc]}
            href={new URL(localePath(pathWithoutLocale, loc), Astro.site).href}
          />
        ))
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'cs' ? 'cs_CZ' : 'de_DE'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    {/* Dimensions let a scraper reserve the card before it has fetched the file,
        and stop Facebook falling back to a small summary card on a slow crawl. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('site.name')} />
    {/* `ogImage` is always the generated /og-default.jpg   see the prop comment
        above for why it is JPEG on purpose. */}
    <meta property="og:image:type" content="image/jpeg" />

    {/*
      Explicit twitter:* rather than relying on X's og: fallback. Not every
      crawler that reads Twitter Cards implements that fallback   several
      answer-engine and chat-app bots read twitter:* directly and show nothing
      if it is absent.
    */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <meta name="twitter:image:alt" content={t('site.name')} />

    {/*
      The client's own favicon, copied from img/cropped-favicon-1-32x32.png.

      It is listed ALONE among the *tab* icons and deliberately. A browser offered
      both this and an SVG picks the SVG wherever it can, so leaving one in place
      would have meant the client's icon never rendering in the browsers that
      matter. The mark's SVG source now lives in src/assets/icon/ instead of
      public/, so it is no longer served at all.

      The apple-touch-icon is a different slot   iOS never uses `rel=icon`   so
      there is no conflict. It is generated at 180� 180 by tools/build-icons.mjs
      from that same SVG, flattened onto --color-les because iOS composites a
      transparent icon onto black.

      ⚠ favicon.png is 32� 32 and the mark is dark on transparent, so it is
      near-invisible in a dark tab strip. Replacing it needs a light-on-dark
      source from the client   see tools/build-icons.mjs.
    */}
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#16241C" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />

    {/*
      Motion gate + failsafe. `is:inline` and in <head> on purpose: it has to run
      before first paint, or elements the reveal system is about to hide would
      flash in at full opacity and then vanish.

      Adding `.js-motion` is what arms every `opacity: 0` rule in global.css.
      The timer is what guarantees they can never stick: if src/scripts/motion.ts
      does not check in within 2 s   chunk 404, parse error, blocked script,
      anything   the class comes off and the page renders complete.
      docs/02-design-system.md §5.1.
    */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js-motion');
        window.__hkMotionFailsafe = setTimeout(function () {
          d.classList.remove('js-motion');
        }, 2000);
      })();
    </script>

    <slot name="head" />
  </head>

  <body>
    <a href="#obsah" class="skip-link">{t('nav.skipToContent')}</a>

    <SiteHeader solid={headerSolid} />

    <main id="obsah">
      <slot />
    </main>

    <SiteFooter />

    <Lightbox />

    <script>
      import '../scripts/motion.ts';
    </script>

    <style>
      /* Off-screen until focused. First thing in the tab order, on every page. */
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1.25rem;
        background: var(--color-mosaz);
        color: var(--color-omitka);
        font-size: var(--text-caption);
        text-decoration: none;
      }

      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
